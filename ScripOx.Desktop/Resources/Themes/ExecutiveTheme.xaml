<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         ScripOx Executive Theme — Inspired by CRMEdge & Hudson 8
         Clean Modern Minimalist + Electric Lime Accent
         Engineered for DACH (German) & UAE Markets
         ============================================================ -->

    <!-- ── Colors ──────────────────────────────────────────────── -->
    <Color x:Key="ExCanvasBgColor">#F6F8FA</Color>
    <Color x:Key="ExSurfaceBgColor">#FFFFFF</Color>
    <Color x:Key="ExSidebarBgColor">#FFFFFF</Color>
    <Color x:Key="ExHeaderBgColor">#FFFFFF</Color>
    
    <!-- Obsidian Dark Shades -->
    <Color x:Key="ExDarkObsidianColor">#0F172A</Color>
    <Color x:Key="ExDarkSurfaceColor">#1E293B</Color>
    <Color x:Key="ExTextPrimaryColor">#0F172A</Color>
    <Color x:Key="ExTextSecondaryColor">#64748B</Color>
    <Color x:Key="ExTextMutedColor">#94A3B8</Color>
    
    <!-- Brand Electric Lime / Chartreuse Accent -->
    <Color x:Key="ExAccentLimeColor">#CEF22C</Color>
    <Color x:Key="ExAccentLimeHoverColor">#BDE01E</Color>
    <Color x:Key="ExAccentLimeLightColor">#F4FCE3</Color>

    <!-- Hairline Borders -->
    <Color x:Key="ExBorderSubtleColor">#E2E8F0</Color>
    <Color x:Key="ExBorderLightColor">#EEF2F6</Color>

    <!-- Status Tints (CRMEdge Pill Style) -->
    <Color x:Key="ExStatusSuccessBgColor">#DCFCE7</Color>
    <Color x:Key="ExStatusSuccessTextColor">#15803D</Color>
    <Color x:Key="ExStatusWarningBgColor">#FEF3C7</Color>
    <Color x:Key="ExStatusWarningTextColor">#B45309</Color>
    <Color x:Key="ExStatusDangerBgColor">#FEE2E2</Color>
    <Color x:Key="ExStatusDangerTextColor">#B91C1C</Color>
    <Color x:Key="ExStatusInfoBgColor">#E0F2FE</Color>
    <Color x:Key="ExStatusInfoTextColor">#0369A1</Color>

    <!-- ── Brushes ─────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="ExCanvasBg"          Color="{StaticResource ExCanvasBgColor}"/>
    <SolidColorBrush x:Key="ExSurfaceBg"         Color="{StaticResource ExSurfaceBgColor}"/>
    <SolidColorBrush x:Key="ExSidebarBg"         Color="{StaticResource ExSidebarBgColor}"/>
    <SolidColorBrush x:Key="ExHeaderBg"          Color="{StaticResource ExHeaderBgColor}"/>
    <SolidColorBrush x:Key="ExDarkObsidian"      Color="{StaticResource ExDarkObsidianColor}"/>
    <SolidColorBrush x:Key="ExDarkSurface"       Color="{StaticResource ExDarkSurfaceColor}"/>
    <SolidColorBrush x:Key="ExTextPrimary"       Color="{StaticResource ExTextPrimaryColor}"/>
    <SolidColorBrush x:Key="ExTextSecondary"     Color="{StaticResource ExTextSecondaryColor}"/>
    <SolidColorBrush x:Key="ExTextMuted"         Color="{StaticResource ExTextMutedColor}"/>
    <SolidColorBrush x:Key="ExAccentLime"        Color="{StaticResource ExAccentLimeColor}"/>
    <SolidColorBrush x:Key="ExAccentLimeHover"   Color="{StaticResource ExAccentLimeHoverColor}"/>
    <SolidColorBrush x:Key="ExAccentLimeLight"   Color="{StaticResource ExAccentLimeLightColor}"/>
    <SolidColorBrush x:Key="ExBorderSubtle"      Color="{StaticResource ExBorderSubtleColor}"/>
    <SolidColorBrush x:Key="ExBorderLight"       Color="{StaticResource ExBorderLightColor}"/>

    <SolidColorBrush x:Key="ExStatusSuccessBg"   Color="{StaticResource ExStatusSuccessBgColor}"/>
    <SolidColorBrush x:Key="ExStatusSuccessText" Color="{StaticResource ExStatusSuccessTextColor}"/>
    <SolidColorBrush x:Key="ExStatusWarningBg"   Color="{StaticResource ExStatusWarningBgColor}"/>
    <SolidColorBrush x:Key="ExStatusWarningText" Color="{StaticResource ExStatusWarningTextColor}"/>
    <SolidColorBrush x:Key="ExStatusDangerBg"    Color="{StaticResource ExStatusDangerBgColor}"/>
    <SolidColorBrush x:Key="ExStatusDangerText"  Color="{StaticResource ExStatusDangerTextColor}"/>
    <SolidColorBrush x:Key="ExStatusInfoBg"      Color="{StaticResource ExStatusInfoBgColor}"/>
    <SolidColorBrush x:Key="ExStatusInfoText"    Color="{StaticResource ExStatusInfoTextColor}"/>

    <!-- ── Fonts ───────────────────────────────────────────────── -->
    <FontFamily x:Key="ExPrimaryFont">Segoe UI, -apple-system, Inter, Roboto</FontFamily>

