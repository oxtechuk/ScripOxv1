    <!-- Search Magnifier -->
    <Geometry x:Key="IconSearchGeom">M15.5,14 H14.71 L14.43,13.73 C15.41,12.59 16,11.11 16,9.5 C16,5.91 13.09,3 9.5,3 C5.91,3 3,5.91 3,9.5 C3,13.09 5.91,16 9.5,16 C11.11,16 12.59,15.41 13.73,14.43 L14,14.71 V15.5 L19,20.49 L20.49,19 L15.5,14 Z M9.5,14 C7.01,14 5,11.99 5,9.5 C5,7.01 7.01,5 9.5,5 C11.99,5 14,7.01 14,9.5 C14,11.99 11.99,14 9.5,14 Z</Geometry>
    <!-- Plus -->
    <Geometry x:Key="IconPlusGeom">M19,13 H13 V19 H11 V13 H5 V11 H11 V5 H13 V11 H19 V13 Z</Geometry>
