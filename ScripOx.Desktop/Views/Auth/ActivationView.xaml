<Window x:Class="ScripOx.Desktop.Views.Auth.ActivationView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScripOx Activation" Height="500" Width="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Similar rounded button style to Login -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#CEF22C"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#bde01e"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1E2A3B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2D4A6B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" Background="#0F172A" BorderBrush="#2D4A6B" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="10" Opacity="0.1" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel -->
            <Border Grid.Column="0" CornerRadius="16,0,0,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0D1B2A" Offset="0"/>
                        <GradientStop Color="#1B3A5C" Offset="0.5"/>
                        <GradientStop Color="#0A3550" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Source="pack://application:,,,/Resources/Images/logo_vertical_white.png"
                           Width="180" HorizontalAlignment="Center" Margin="0,0,0,32" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Software License Required" FontSize="20" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Please activate your copy to continue." FontSize="13" Foreground="#7AAFCC" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Right Panel: Activation Form -->
            <Border Grid.Column="1" Background="#0F172A" CornerRadius="0,16,16,0" Padding="40">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Activate ScripOx" FontSize="28" FontWeight="ExtraBold" Foreground="White" Margin="0,0,0,8"/>
                    <TextBlock Text="Enter your premium license key below." FontSize="14" Foreground="#A0B2C6" Margin="0,0,0,32"/>

                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Hardware ID (Your Machine Code)" FontSize="12" FontWeight="SemiBold" Foreground="#A0B2C6" VerticalAlignment="Center"/>
                        <TextBlock Text="Click to Copy" FontSize="10" FontWeight="SemiBold" Foreground="#4A9FD4" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"/>
                    </Grid>
                    
                    <TextBox x:Name="TxtHardwareId" Style="{StaticResource InputTextBoxStyle}" IsReadOnly="True" 
                             Background="#152033" Foreground="#7AAFCC" Margin="0,0,0,24" 
                             Cursor="Hand" ToolTip="Click to copy your Hardware ID"
                             PreviewMouseLeftButtonUp="TxtHardwareId_PreviewMouseLeftButtonUp" />

                    <TextBlock Text="License Key" FontSize="12" FontWeight="SemiBold" Foreground="#A0B2C6" Margin="0,0,0,8"/>
                    <TextBox x:Name="TxtLicenseKey" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,8" MaxLength="50" FontSize="16" FontWeight="SemiBold" Padding="12,12"/>

                    <TextBlock x:Name="TxtError" Foreground="#EF4444" FontSize="13" FontWeight="SemiBold" Visibility="Collapsed" Margin="0,0,0,16" TextWrapping="Wrap"/>

                    <Button x:Name="BtnActivate" Content="Activate Now" Style="{StaticResource PrimaryButtonStyle}" Click="BtnActivate_Click" Margin="0,16,0,0" FontSize="15" Height="45"/>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                        <TextBlock Text="Don't have a license?" FontSize="13" Foreground="#A0B2C6" Margin="0,0,6,0"/>
                        <TextBlock Text="Get one here" FontSize="13" FontWeight="Bold" Foreground="#4A9FD4" Cursor="Hand" MouseLeftButtonDown="LinkPurchase_MouseLeftButtonDown"/>
                    </StackPanel>

                    <Button Content="Exit Application" Background="Transparent" Foreground="#64748B" BorderThickness="0" Margin="0,16,0,0" Click="BtnExit_Click"/>
                </StackPanel>
            </Border>

            <!-- Close Button -->
            <Button Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" Width="30" Height="30" Background="Transparent" BorderThickness="0" Click="BtnExit_Click">
                <TextBlock Text="✕" FontSize="16" Foreground="#A0B2C6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
        </Grid>
    </Border>
</Window>
