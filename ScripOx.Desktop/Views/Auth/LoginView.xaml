<Window x:Class="ScripOx.Desktop.Views.Auth.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScripOx — Sign In"
        Width="900" Height="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>

        <!-- ── TextBox style (dark theme — text visible fix) ── -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background"         Value="#1E2A3B"/>
            <Setter Property="Foreground"         Value="#ffff"/>
            <Setter Property="BorderBrush"        Value="#2D4A6B"/>
            <Setter Property="BorderThickness"    Value="1"/>
            <Setter Property="Padding"            Value="12,10"/>
            <Setter Property="FontSize"           Value="14"/>
            <Setter Property="FontFamily"         Value="Segoe UI"/>
            <Setter Property="CaretBrush"         Value="#4A9FD4"/>
            <Setter Property="SelectionBrush"     Value="#1D6FA4"/>
            <Setter Property="SelectionTextBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <!--
                                TextElement.Foreground on the ScrollViewer is required
                                in WPF dark themes — the ControlTemplate does NOT
                                automatically inherit Foreground from the TextBox.
                            -->
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4A9FD4"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3D7FAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── PasswordBox style ── -->
        <Style x:Key="PasswordStyle" TargetType="PasswordBox">
            <Setter Property="Background"      Value="#1E2A3B"/>
            <Setter Property="Foreground"      Value="#E8EDF3"/>
            <Setter Property="BorderBrush"     Value="#2D4A6B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="12,10"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="CaretBrush"      Value="#4A9FD4"/>
            <Setter Property="SelectionBrush"  Value="#1D6FA4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4A9FD4"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3D7FAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Outer border with drop shadow -->
    <Border CornerRadius="16" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Color="#000000" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>   <!-- Left branding panel -->
                <ColumnDefinition Width="380"/> <!-- Right login form -->
            </Grid.ColumnDefinitions>

            <!-- ── Left Panel (drag area — no interactive elements) ── -->
            <Border Grid.Column="0" CornerRadius="16,0,0,16"
                    MouseLeftButtonDown="Window_MouseLeftButtonDown"
                    Cursor="SizeAll">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0D1B2A" Offset="0"/>
                        <GradientStop Color="#1B3A5C" Offset="0.5"/>
                        <GradientStop Color="#0A3550" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- Logo -->
                    <Ellipse Width="80" Height="80" HorizontalAlignment="Center">
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1D6FA4" Offset="0"/>
                                <GradientStop Color="#4A9FD4" Offset="1"/>
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="ScripOx"
                               FontSize="32" FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,4"
                               FontFamily="Segoe UI"/>
                    <TextBlock Text="Ox Tech — oxtech.uk"
                               FontSize="13"
                               Foreground="#7AAFCC"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,32"
                               FontFamily="Segoe UI"/>

                    <!-- Features list -->
                    <StackPanel>
                        <TextBlock Text="✦  Company Data Management" Foreground="#A8C9E0" FontSize="13" Margin="0,6"/>
                        <TextBlock Text="✦  Multi-Source Extraction"  Foreground="#A8C9E0" FontSize="13" Margin="0,6"/>
                        <TextBlock Text="✦  Interactive Map Explorer" Foreground="#A8C9E0" FontSize="13" Margin="0,6"/>
                        <TextBlock Text="✦  Excel Export &amp; Reports"  Foreground="#A8C9E0" FontSize="13" Margin="0,6"/>
                        <TextBlock Text="✦  Arabic / English Support"  Foreground="#A8C9E0" FontSize="13" Margin="0,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── Right Panel (Login Form) ── -->
            <Border Grid.Column="1" Background="#0D1B2A" CornerRadius="0,16,16,0">
                <StackPanel VerticalAlignment="Center" Margin="40,0">

                    <!-- Title row + close button -->
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Sign In" FontSize="26" FontWeight="SemiBold"
                                   Foreground="White" FontFamily="Segoe UI"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="BtnClose" Content="✕"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#7AAFCC" FontSize="16"
                                Cursor="Hand" Click="BtnClose_Click"/>
                    </Grid>

                    <TextBlock Text="Welcome back to ScripOx"
                               Foreground="#4A7FA0" FontSize="13"
                               Margin="0,0,0,32"/>

                    <!-- Username -->
                    <TextBlock Text="Username" Foreground="#7AAFCC" FontSize="12" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtUsername"
                             Style="{StaticResource InputStyle}"
                             Height="44"
                             Margin="0,0,0,16"/>

                    <!-- Password -->
                    <TextBlock Text="Password" Foreground="#7AAFCC" FontSize="12" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="TxtPassword"
                                 Style="{StaticResource PasswordStyle}"
                                 Height="44"
                                 Margin="0,0,0,8"/>

                    <!-- Error message -->
                    <TextBlock x:Name="TxtError"
                               Foreground="#FF6B6B"
                               FontSize="12"
                               Margin="0,0,0,12"
                               Visibility="Collapsed"
                               TextWrapping="Wrap"/>

                    <!-- Language toggle -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <TextBlock Text="Language:" Foreground="#4A7FA0" FontSize="12" VerticalAlignment="Center"/>
                        <RadioButton x:Name="RbEn" Content="English"
                                     IsChecked="True"
                                     Foreground="#A8C9E0" FontSize="12"
                                     Margin="8,0,8,0" VerticalAlignment="Center"
                                     Click="Language_Click"/>
                        <RadioButton x:Name="RbAr" Content="عربي"
                                     Foreground="#A8C9E0" FontSize="12"
                                     VerticalAlignment="Center"
                                     Click="Language_Click"/>
                    </StackPanel>

                    <!-- Login Button -->
                    <Button x:Name="BtnLogin" Height="46"
                            Click="BtnLogin_Click"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="10">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#1D6FA4" Offset="0"/>
                                            <GradientStop Color="#2A9FD4" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock x:Name="BtnLoginText"
                                   Text="Sign In"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="White"/>
                    </Button>

                    <TextBlock Text="© 2025 Ox Tech — oxtech.uk"
                               Foreground="#2D4A6B" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,24,0,0"/>
                </StackPanel>
            </Border>

            <!-- Window drag: handled on left panel only (see above) -->
        </Grid>
    </Border>
</Window>
