<Page x:Class="ScripOx.Desktop.Views.Companies.CompaniesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Companies Management"
      Background="{StaticResource ExCanvasBg}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Search & Actions Bar -->
            <RowDefinition Height="*"/>     <!-- Table Card -->
            <RowDefinition Height="Auto"/>  <!-- Pagination -->
        </Grid.RowDefinitions>

        <!-- ── Top Search & Action Bar (CRMEdge Style) ───────── -->
        <Border Grid.Row="0" Margin="0,0,0,20" Background="{StaticResource ExSurfaceBg}"
                CornerRadius="14" Padding="16,12" BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search & Filters -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Pill Search Input -->
                    <Border Width="220" Background="{StaticResource ExCanvasBg}" CornerRadius="18"
                            BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="1" Padding="12,6" Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IconSearchGeom}" Fill="{StaticResource ExTextMuted}"
                                  Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtSearch" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource ExTextPrimary}" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Segment / Category Dropdown -->
                    <ComboBox x:Name="CmbSegment" Width="140" Height="34" Margin="0,0,10,0"
                              Background="{StaticResource ExCanvasBg}" Foreground="{StaticResource ExTextPrimary}"
                              BorderBrush="{StaticResource ExBorderSubtle}"
                              VerticalContentAlignment="Center" FontSize="11"/>

                    <!-- Rating / Priority Dropdown -->
                    <ComboBox x:Name="CmbPriority" Width="110" Height="34" Margin="0,0,10,0"
                              Background="{StaticResource ExCanvasBg}" Foreground="{StaticResource ExTextPrimary}"
                              BorderBrush="{StaticResource ExBorderSubtle}"
                              VerticalContentAlignment="Center" FontSize="11">
                        <ComboBoxItem Content="All Ratings" IsSelected="True"/>
                        <ComboBoxItem Content="★★★ High" Tag="high"/>
                        <ComboBoxItem Content="★★ Medium" Tag="medium"/>
                        <ComboBoxItem Content="★ Low" Tag="low"/>
                    </ComboBox>

                    <!-- Status Dropdown -->
                    <ComboBox x:Name="CmbStatus" Width="130" Height="34" Margin="0,0,10,0"
                              Background="{StaticResource ExCanvasBg}" Foreground="{StaticResource ExTextPrimary}"
                              BorderBrush="{StaticResource ExBorderSubtle}" DisplayMemberPath="Name" SelectedValuePath="Id"
                              VerticalContentAlignment="Center" FontSize="11"/>

                    <!-- Filter Button -->
                    <Button x:Name="BtnFilter" Content="Filter" Click="BtnFilter_Click" Style="{StaticResource ExBtnGhostPill}"
                            Height="34" Padding="14,0"/>
                </StackPanel>

                <!-- Action Buttons (Right) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnAddCompany" Content="+ Add Company" Click="BtnAddCompany_Click" Style="{StaticResource ExBtnBlackPill}"
                            Height="36" Padding="16,0" Margin="0,0,10,0"/>
                    <Button x:Name="BtnImportExcel" Content="Import Excel" Click="BtnImportExcel_Click" Style="{StaticResource ExBtnGhostPill}"
                            Height="36" Padding="14,0" Margin="0,0,8,0"/>
                    <Button x:Name="BtnDownloadExample" Content="Template" Click="BtnDownloadExample_Click" Style="{StaticResource ExBtnGhostPill}"
                            Height="36" Padding="12,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Main DataGrid Card (CRMEdge Matrix Style) ─────── -->
        <Border Grid.Row="1" Style="{StaticResource ExCard}" Padding="0">
            <DataGrid x:Name="DgCompanies" Style="{StaticResource ExDataGrid}"
                      ColumnHeaderStyle="{StaticResource ExDataGridHeader}"
                      IsReadOnly="True" MouseDoubleClick="DgCompanies_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                    <DataGridTextColumn Header="Company Name" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="Segment / Category" Binding="{Binding Category}" Width="1.2*"/>
                    <DataGridTemplateColumn Header="Rating / Priority" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource ExCanvasBg}" BorderBrush="{Binding PriorityColor}" BorderThickness="1"
                                        CornerRadius="12" Padding="8,3" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding PriorityDisplay}" Foreground="{Binding PriorityColor}" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="City / Region" Binding="{Binding City}" Width="*"/>
                    <DataGridTextColumn Header="Contact Phone" Binding="{Binding Phone}" Width="130"/>
                    <DataGridTemplateColumn Header="Status" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding StatusColor}" CornerRadius="12" Padding="10,4" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding StatusName}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="CRM Action" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="CRM Profile" Style="{StaticResource ExBtnGhostPill}"
                                        Height="26" Padding="10,0" FontSize="11" Click="BtnViewLead_Click" Tag="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ── Bottom Pagination (Clean Pill Controls) ───────── -->
        <Border Grid.Row="2" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="&lt; Prev" x:Name="BtnPrev" Click="BtnPrev_Click" Style="{StaticResource ExBtnGhostPill}"
                        Height="32" Padding="14,0" Margin="0,0,12,0"/>
                <TextBlock x:Name="TxtPageInfo" Text="Page 1 of 1" Foreground="{StaticResource ExTextSecondary}"
                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="Next &gt;" x:Name="BtnNext" Click="BtnNext_Click" Style="{StaticResource ExBtnGhostPill}"
                        Height="32" Padding="14,0" Margin="12,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
