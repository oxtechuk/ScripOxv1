<Page x:Class="ScripOx.Desktop.Views.Companies.CompaniesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="إدارة الشركات والعملاء"
      Background="{StaticResource ExCanvasBg}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0: Search & Filters Bar -->
            <RowDefinition Height="Auto"/>  <!-- 1: Custom Group & Batch Assignment Toolbar -->
            <RowDefinition Height="*"/>     <!-- 2: Main DataGrid Card -->
            <RowDefinition Height="Auto"/>  <!-- 3: Bottom Pagination -->
        </Grid.RowDefinitions>

        <!-- ── 0. Top Search & Action Bar (Sharp Modern Tech Style) ── -->
        <Border Grid.Row="0" Margin="0,0,0,12" Background="{StaticResource ExSurfaceBg}"
                CornerRadius="6" Padding="14,10" BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search & Filters -->
                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,-8">
                    <!-- Search Input (Flat Modern Tech Style) -->
                    <Border Width="220" Height="34" Background="{StaticResource ExCanvasBg}" CornerRadius="4"
                            BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="1" Padding="10,0" Margin="0,0,8,8">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IconSearchGeom}" Fill="{StaticResource ExTextMuted}"
                                  Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtSearch" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource ExTextPrimary}" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Segment / Category Dropdown -->
                    <ComboBox x:Name="CmbSegment" Width="140" Height="34" Margin="0,0,6,8"/>

                    <!-- Rating / Priority Dropdown -->
                    <ComboBox x:Name="CmbPriority" Width="125" Height="34" Margin="0,0,6,8">
                        <ComboBoxItem Content="جميع الأولويات" IsSelected="True"/>
                        <ComboBoxItem Content="★★★ أولوية عالية" Tag="high"/>
                        <ComboBoxItem Content="★★ أولوية متوسطة" Tag="medium"/>
                        <ComboBoxItem Content="★ أولوية منخفضة" Tag="low"/>
                    </ComboBox>

                    <!-- Status Dropdown -->
                    <ComboBox x:Name="CmbStatus" Width="130" Height="34" Margin="0,0,6,8"
                              DisplayMemberPath="DisplayName" SelectedValuePath="Id"/>

                    <!-- Sorting Dropdown (فرز بالتاريخ وتاريخ آخر تحديث) -->
                    <ComboBox x:Name="CmbSort" Width="175" Height="34" Margin="0,0,6,8">
                        <ComboBoxItem Content="⏱️ تاريخ الإضافة (الأحدث)" Tag="created_desc" IsSelected="True"/>
                        <ComboBoxItem Content="⏱️ تاريخ الإضافة (الأقدم)" Tag="created_asc"/>
                        <ComboBoxItem Content="🔄 آخر تحديث (الأحدث)" Tag="updated_desc"/>
                        <ComboBoxItem Content="🔄 آخر تحديث (الأقدم)" Tag="updated_asc"/>
                        <ComboBoxItem Content="🔤 اسم الشركة (أ - ي)" Tag="name_asc"/>
                    </ComboBox>

                    <!-- Filter Button -->
                    <Button x:Name="BtnFilter" Content="تصفية 🔍" Click="BtnFilter_Click" Style="{StaticResource ExBtnBlackPill}"
                            Height="34" Padding="14,0" Margin="0,0,6,8"/>

                    <!-- Reset Filter Button (مسح الفلتر) -->
                    <Button x:Name="BtnResetFilter" Content="مسح الفلتر ✕" Click="BtnResetFilter_Click" Style="{StaticResource ExBtnGhostPill}"
                            Height="34" Padding="12,0" Margin="0,0,0,8"/>
                </WrapPanel>

                <!-- Action Buttons (Right) -->
                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,0,0,-8">
                    <Button x:Name="BtnAddCompany" Content="+ إضافة شركة" Click="BtnAddCompany_Click" Style="{StaticResource ExBtnBlackPill}"
                            Height="34" Padding="14,0" Margin="0,0,8,8"/>
                    
                    <Button x:Name="BtnImportJson" Content="استيراد JSON" Click="BtnImportJson_Click" Style="{StaticResource ExBtnGhostPill}"
                            Height="34" Padding="12,0" Margin="0,0,6,8"/>

                    <Button x:Name="BtnImportExcel" Content="استيراد إكسل" Click="BtnImportExcel_Click" Style="{StaticResource ExBtnGhostPill}"
                            Height="34" Padding="12,0" Margin="0,0,6,8"/>
                    <Button x:Name="BtnDownloadExample" Content="نموذج الإكسل" Click="BtnDownloadExample_Click" Style="{StaticResource ExBtnGhostPill}"
                            Height="34" Padding="12,0" Margin="0,0,0,8"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ── 1. Custom Group & Data Management Toolbar (مجموعات البيانات ومسح الداتا) ── -->
        <Border Grid.Row="1" Margin="0,0,0,12" Background="{StaticResource ExSurfaceBg}"
                CornerRadius="6" Padding="12,8" BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Selection Info & Delete Actions -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkSelectAllTop" Content="تحديد الكل" Click="ChkSelectAllTop_Click"
                              Foreground="{StaticResource ExTextPrimary}" FontWeight="SemiBold" FontSize="11.5"
                              VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <!-- Crisp Flat Counter Badge (No lime curves) -->
                    <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"
                            CornerRadius="3" Padding="8,2" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtSelectedCount" Text="محدد: 0" Foreground="#334155"
                                   FontWeight="Bold" FontSize="11"/>
                    </Border>

                    <!-- Flat Ghost Action Buttons -->
                    <Button x:Name="BtnClearSelection" Content="إلغاء التحديد" Click="BtnClearSelection_Click"
                            Style="{StaticResource ExBtnGhostPill}" Height="28" Padding="10,0" FontSize="11" Margin="0,0,10,0"/>

                    <!-- Delete Selected Companies Button (حذف المحدد) -->
                    <Button x:Name="BtnDeleteSelected" Content="🗑️ حذف المحدد" Click="BtnDeleteSelected_Click"
                            Style="{StaticResource ExBtnDangerPill}" Height="28" Padding="12,0" FontSize="11" Margin="0,0,8,0"/>

                    <!-- Wipe Entire Table Button (تفريغ الجدول بالكامل) -->
                    <Button x:Name="BtnClearAllTable" Content="⚠️ تفريغ جدول الشركات" Click="BtnClearAllTable_Click"
                            Style="{StaticResource ExBtnDangerPill}" Height="28" Padding="12,0" FontSize="11"/>
                </StackPanel>

                <!-- Right: Custom Group Input and Assign -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="LblTargetGroup" Text="المجموعة المستهدفة:" Foreground="{StaticResource ExTextSecondary}" FontSize="11.5"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CmbTargetGroup" Width="180" Height="30" Margin="0,0,8,0" IsEditable="True"/>
                    <Button x:Name="BtnAssignGroup" Content="📌 حفظ للمجموعة" Click="BtnAssignGroup_Click"
                            Style="{StaticResource ExBtnBlackPill}" Height="30" Padding="14,0" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── 2. Main DataGrid Card (Sharp Borders & Proper Arabic Alignment) ── -->
        <Border Grid.Row="2" Style="{StaticResource ExCard}" Padding="0" Margin="0,0,0,12" CornerRadius="6">
            <DataGrid x:Name="DgCompanies" Style="{StaticResource ExDataGrid}"
                      ColumnHeaderStyle="{StaticResource ExDataGridHeader}"
                      IsReadOnly="True" MouseDoubleClick="DgCompanies_MouseDoubleClick">
                <DataGrid.Columns>
                    <!-- Individual Row Selection Checkbox (تحديد بالواحد) -->
                    <DataGridTemplateColumn Width="42">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Click="RowCheckBox_Click"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="المعرف" Binding="{Binding Id}" Width="55"/>
                    <DataGridTextColumn Header="اسم الشركة" Binding="{Binding DisplayName}" Width="1.8*"/>
                    <DataGridTextColumn Header="المجموعة / التصنيف" Binding="{Binding Category}" Width="1.2*"/>

                    <!-- Priority Badge (Sharp Modern Rectangle) -->
                    <DataGridTemplateColumn Header="الأولوية" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource ExCanvasBg}" BorderBrush="{Binding PriorityColor}" BorderThickness="1"
                                        CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding PriorityDisplay}" Foreground="{Binding PriorityColor}" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="المدينة / المنطقة" Binding="{Binding City}" Width="*"/>
                    <DataGridTextColumn Header="هاتف الاتصال" Binding="{Binding Phone}" Width="125"/>

                    <!-- Status Badge (Sharp Clean Rectangle) -->
                    <!-- Status Badge (Sharp Clean Rectangle) -->
                    <DataGridTemplateColumn Header="الحالة" Width="95">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding StatusColor}" CornerRadius="3" Padding="8,3" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding StatusDisplay}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="تاريخ الإضافة" Binding="{Binding CreatedAtDisplay}" Width="135"/>
                    <DataGridTextColumn Header="آخر تحديث" Binding="{Binding UpdatedAtDisplay}" Width="135"/>

                    <!-- CRM Action Button (Flat Ghost Style) -->
                    <DataGridTemplateColumn Header="ملف العميل" Width="95">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{Binding ViewProfileText}" Style="{StaticResource ExBtnGhostPill}"
                                        Height="24" Padding="8,0" FontSize="10.5" Click="BtnViewLead_Click" Tag="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ── 3. Bottom Pagination (Sharp Controls & Arabic Text) ── -->
        <Border Grid.Row="3">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="‹ السابق" x:Name="BtnPrev" Click="BtnPrev_Click" Style="{StaticResource ExBtnGhostPill}"
                        Height="30" Padding="14,0" Margin="0,0,10,0"/>
                <TextBlock x:Name="TxtPageInfo" Text="صفحة 1 من 1" Foreground="{StaticResource ExTextSecondary}"
                           FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="التالي ›" x:Name="BtnNext" Click="BtnNext_Click" Style="{StaticResource ExBtnGhostPill}"
                        Height="30" Padding="14,0" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
