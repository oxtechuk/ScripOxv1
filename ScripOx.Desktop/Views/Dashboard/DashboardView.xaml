<Window x:Class="ScripOx.Desktop.Views.Dashboard.DashboardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScripOx.Desktop.Views.Dashboard"
        Title="ScripOx — Executive CRM &amp; Data Hub"
        Width="1380" Height="860"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <!-- VS Code Activity Bar Style Navigation Button (Clean Line Icons & Rounded Capsule) -->
        <Style x:Key="ExNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource ExTextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent"
                                CornerRadius="8" Margin="3,2" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="Center">
                                <!-- VS Code Rounded Square Pill Capsule -->
                                <Border x:Name="IconCapsule" Width="38" Height="36" CornerRadius="8"
                                        Background="{TemplateBinding Background}"
                                        VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Path x:Name="IconPath"
                                          Data="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(local:NavHelper.Icon)}"
                                          Stroke="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground}"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="18" Height="18" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ContentPresenter x:Name="TxtContent"
                                                  Margin="10,0,0,0"
                                                  VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Content" Value="{x:Null}">
                                <Setter TargetName="TxtContent" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="Background" Value="Transparent"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="IconCapsule" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="{StaticResource ExTextPrimary}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="16" ClipToBounds="True" Background="{StaticResource ExCanvasBg}"
            BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="240"/>   <!-- Sidebar -->
                <ColumnDefinition Width="*"/>                           <!-- Main Workspace -->
            </Grid.ColumnDefinitions>

            <!-- ── Left Sidebar (Hudson 8 & CRMEdge Hybrid) ─────── -->
            <Border Grid.Column="0" x:Name="SidebarBorder"
                    Background="{StaticResource ExSidebarBg}"
                    BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="0,0,1,0"
                    MouseEnter="Sidebar_MouseEnter" MouseLeave="Sidebar_MouseLeave">
                <DockPanel>

                    <!-- Top Branding -->
                    <StackPanel DockPanel.Dock="Top" x:Name="PanelLogo" Margin="20,16,20,16">
                        <Image Source="pack://application:,,,/Resources/Images/main_logo.png"
                               Height="65"
                               HorizontalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </StackPanel>

                    <!-- Collapsed Mini Logo -->
                    <StackPanel DockPanel.Dock="Top" x:Name="PanelMiniLogo" Margin="0,24,0,24" HorizontalAlignment="Center" Visibility="Collapsed">
                        <Image Source="pack://application:,,,/Resources/Images/logo_vertical_black.png"
                               Width="40"
                               HorizontalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </StackPanel>

                    <!-- Bottom: User Card -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <!-- User Profile Info Capsule -->
                        <Border x:Name="PanelUserInfo" Margin="14,0,14,18"
                                Background="{StaticResource ExCanvasBg}" CornerRadius="12" Padding="12,10"
                                BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <Border Width="34" Height="34" CornerRadius="17" Background="#E2E8F0" Margin="0,0,10,0">
                                    <TextBlock Text="AD" FontSize="12" FontWeight="Bold" Foreground="{StaticResource ExDarkObsidian}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtUserName" Text="Admin" FontSize="12"
                                               Foreground="{StaticResource ExTextPrimary}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtUserRole" Text="مدير النظام (Admin)" FontSize="10"
                                               Foreground="{StaticResource ExTextSecondary}"/>
                                </StackPanel>

                                <Button x:Name="BtnSignOut" Grid.Column="2" Content="خروج" Height="26"
                                        Style="{StaticResource ExBtnGhostPill}" FontSize="10" Padding="8,2"
                                        Click="BtnSignOut_Click"/>
                            </Grid>
                        </Border>

                        <!-- Mini Sign Out when sidebar collapsed -->
                        <Button x:Name="BtnMiniSignOut" Content="خروج" Style="{StaticResource ExBtnGhostPill}"
                                Height="34" Width="34" HorizontalAlignment="Center" Margin="0,0,0,16"
                                Visibility="Collapsed" Click="BtnSignOut_Click" ToolTip="تسجيل الخروج"/>
                    </StackPanel>

                    <!-- Navigation Items List (Zero Emoji - Executive Vector Icons) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="10,0">
                            <Button Content="لوحة التحكم"      Style="{StaticResource ExNavButton}" x:Name="BtnNavDashboard"  Click="Nav_Click" Tag="dashboard"  local:NavHelper.Icon="{StaticResource IconDashboardGeom}"/>
                            <Button Content="الشركات"          Style="{StaticResource ExNavButton}" x:Name="BtnNavCompanies"  Click="Nav_Click" Tag="companies"  local:NavHelper.Icon="{StaticResource IconBuildingGeom}"/>
                            <Button Content="المصادر"          Style="{StaticResource ExNavButton}" x:Name="BtnNavSources"    Click="Nav_Click" Tag="sources"    local:NavHelper.Icon="{StaticResource IconGlobeGeom}"/>
                            <Button Content="مهام الاستخراج"    Style="{StaticResource ExNavButton}" x:Name="BtnNavJobs"       Click="Nav_Click" Tag="jobs"       local:NavHelper.Icon="{StaticResource IconJobsGeom}"/>
                            <Button Content="السجلات الخام"    Style="{StaticResource ExNavButton}" x:Name="BtnNavRaw"        Click="Nav_Click" Tag="raw"        local:NavHelper.Icon="{StaticResource IconDatabaseGeom}"/>
                            <Button Content="مستكشف الخريطة"   Style="{StaticResource ExNavButton}" x:Name="BtnNavMap"        Click="Nav_Click" Tag="map"        local:NavHelper.Icon="{StaticResource IconMapGeom}"/>
                            <Button Content="مركز التصدير"     Style="{StaticResource ExNavButton}" x:Name="BtnNavExports"    Click="Nav_Click" Tag="exports"    local:NavHelper.Icon="{StaticResource IconExportGeom}"/>
                            <Button Content="إضافة المتصفح"    Style="{StaticResource ExNavButton}" x:Name="BtnNavExtension" Click="Nav_Click" Tag="extension"  local:NavHelper.Icon="{StaticResource IconExtensionGeom}"/>
                            <Separator x:Name="SepNav" Background="{StaticResource ExBorderSubtle}" Margin="12,10"/>
                            <Button Content="الإعدادات"        Style="{StaticResource ExNavButton}" x:Name="BtnNavSettings"   Click="Nav_Click" Tag="settings"   local:NavHelper.Icon="{StaticResource IconSettingsGeom}"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ── Main Content Area ────────────────────────────── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Update Banner (Auto height, collapsed when not active) -->
                    <RowDefinition Height="64"/>   <!-- Modern Topbar -->
                    <RowDefinition Height="*"/>    <!-- Active Page -->
                </Grid.RowDefinitions>

                <!-- ── Update Notification Banner (Dark Obsidian with Lime Accent) ── -->
                <Border x:Name="BannerUpdateNotification" Grid.Row="0"
                        Background="{StaticResource ExDarkObsidian}"
                        BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="0,0,0,1"
                        Padding="20,10" Visibility="Collapsed">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource ExAccentLime}" Margin="0,0,10,0"/>
                            <TextBlock x:Name="TxtBannerUpdateMessage"
                                       Text="A new version of ScripOx is available."
                                       Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="BtnBannerViewDetails" Content="View Update"
                                    Background="{StaticResource ExAccentLime}" Foreground="{StaticResource ExDarkObsidian}"
                                    FontWeight="Bold" FontSize="11" Height="28" Padding="14,0" Margin="0,0,10,0"
                                    BorderThickness="0" Cursor="Hand" Click="BtnBannerViewDetails_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="14"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button x:Name="BtnBannerDismiss" Content="✕" Width="26" Height="26"
                                    Background="Transparent" BorderThickness="0" Foreground="{StaticResource ExTextMuted}"
                                    FontSize="11" Cursor="Hand" Click="BtnBannerDismiss_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── Modern Executive Topbar (CRMEdge Style) ───── -->
                <Border Grid.Row="1" Background="{StaticResource ExHeaderBg}"
                        BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="Window_MouseLeftButtonDown">
                    <Grid Margin="20,0">
                        <!-- Left: Sidebar Toggle + Title -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnToggleSidebar" Content="☰" FontSize="16" FontWeight="SemiBold"
                                    Width="36" Height="36" Cursor="Hand" Background="{StaticResource ExCanvasBg}"
                                    BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="1"
                                    Foreground="{StaticResource ExTextSecondary}" Click="BtnToggleSidebar_Click" Margin="0,0,16,0"
                                    Style="{StaticResource ExBtnGhostPill}"/>
                            <TextBlock x:Name="TxtPageTitle"
                                       Text="إدارة الشركات" FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource ExTextPrimary}" VerticalAlignment="Center"
                                       FontFamily="{StaticResource ExPrimaryFont}"/>
                        </StackPanel>

                        <!-- Middle: Wide Autocomplete Search Input (Flat Modern Tech Style) -->
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border x:Name="SearchPillBorder" Width="480" Height="36"
                                    Background="{StaticResource ExCanvasBg}" CornerRadius="4"
                                    BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="1" Padding="12,0">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource IconSearchGeom}"
                                          Stroke="{StaticResource ExTextMuted}" StrokeThickness="1.5"
                                          Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox x:Name="TxtGlobalSearch" Grid.Column="1" Text="بحث في الشركات، السجلات، أو الصفقات..."
                                             Background="Transparent" BorderThickness="0" Foreground="{StaticResource ExTextSecondary}"
                                             FontSize="12" VerticalAlignment="Center"
                                             GotFocus="TxtGlobalSearch_GotFocus" LostFocus="TxtGlobalSearch_LostFocus"
                                             TextChanged="TxtGlobalSearch_TextChanged"
                                             KeyDown="TxtGlobalSearch_KeyDown"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="BtnClearSearch" Content="✕" Width="20" Height="20"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="{StaticResource ExTextMuted}" Cursor="Hand"
                                                Visibility="Collapsed" Click="BtnClearSearch_Click" Margin="0,0,6,0"
                                                ToolTip="مسح البحث"/>
                                        <Border Background="{StaticResource ExBorderLight}" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="↵ Enter" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource ExTextSecondary}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Live Autocomplete Suggestions Popup -->
                            <Popup x:Name="PopupSuggestions" PlacementTarget="{Binding ElementName=SearchPillBorder}"
                                   Placement="Bottom" VerticalOffset="6" IsOpen="False" StaysOpen="False"
                                   AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Width="480" MaxHeight="380" Background="#FFFFFF"
                                        BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="1"
                                        CornerRadius="6" Padding="0" Margin="0,0,0,10">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" Direction="270" ShadowDepth="3" Color="#0F172A" Opacity="0.10"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>  <!-- Suggestions Header -->
                                            <RowDefinition Height="*"/>     <!-- Results List -->
                                            <RowDefinition Height="Auto"/>  <!-- Footer Action -->
                                        </Grid.RowDefinitions>

                                        <!-- Header -->
                                        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="{StaticResource ExBorderLight}" BorderThickness="0,0,0,1"
                                                CornerRadius="6,6,0,0" Padding="14,8">
                                            <Grid>
                                                <TextBlock x:Name="TxtSuggestionsHeader" Text="اقتراحات البحث المباشرة" FontSize="11" FontWeight="Bold"
                                                           Foreground="{StaticResource ExTextSecondary}"/>
                                                <TextBlock x:Name="TxtSuggestionsCount" Text="0 نتائج" FontSize="11"
                                                           Foreground="{StaticResource ExTextMuted}" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>

                                        <!-- List of Matches -->
                                        <ScrollViewer Grid.Row="1" MaxHeight="270" VerticalScrollBarVisibility="Auto">
                                            <ListBox x:Name="LstSuggestions" Background="Transparent" BorderThickness="0"
                                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                      SelectionChanged="LstSuggestions_SelectionChanged">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="12,8" CornerRadius="4" Margin="4,2" Background="Transparent">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#F1F5F9"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Company Avatar / Icon -->
                                                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="4"
                                                                        Background="#F1F5F9" Margin="0,0,10,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="🏢" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>

                                                                <!-- Name & Info -->
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"
                                                                               Foreground="{StaticResource ExTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                        <Border Background="{StaticResource ExCanvasBg}" BorderBrush="{StaticResource ExBorderLight}" BorderThickness="1"
                                                                                CornerRadius="3" Padding="6,1" Margin="0,0,6,0">
                                                                            <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{StaticResource ExTextSecondary}"/>
                                                                        </Border>
                                                                        <TextBlock Text="{Binding Phone}" FontSize="11" Foreground="{StaticResource ExTextMuted}"
                                                                                   VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </StackPanel>

                                                                <!-- Arrow / Open hint -->
                                                                <TextBlock Grid.Column="2" Text="عرض ملف العميل ➔" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource ExDarkObsidian}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </ScrollViewer>

                                        <!-- Footer View All Action -->
                                        <Border Grid.Row="2" Background="#FAFBFD" BorderBrush="{StaticResource ExBorderLight}" BorderThickness="0,1,0,0"
                                                CornerRadius="0,0,6,6" Padding="14,9">
                                            <Button x:Name="BtnViewAllSearch" Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" Click="BtnViewAllSearch_Click" HorizontalAlignment="Stretch">
                                                <Grid>
                                                    <TextBlock Text="عرض كافة النتائج في جدول الشركات الكامل ↵"
                                                                FontSize="11" FontWeight="Bold" Foreground="{StaticResource ExDarkObsidian}"/>
                                                </Grid>
                                            </Button>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- Right: Actions + Markets + Controls -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            
                            <!-- Action Button (Flat Sharp Style) -->
                            <Button x:Name="BtnCreateRecord" Content="+ إضافة سجل جديد" Style="{StaticResource ExBtnBlackPill}"
                                    Height="34" Margin="0,0,12,0" Padding="14,0" FontSize="11.5" Click="BtnCreateRecord_Click"/>

                            <!-- Trilingual Flag Selector (EN 🇬🇧 / DE 🇩🇪 / AR 🇸🇦) -->
                            <Border Background="{StaticResource ExCanvasBg}" CornerRadius="4"
                                    BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="1"
                                    Padding="2" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnLangEN" Click="BtnLang_Click" Tag="en"
                                            ToolTip="English"
                                            Style="{StaticResource ExBtnGhostPill}" Height="28" Padding="7,0" FontSize="11" FontWeight="SemiBold">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border CornerRadius="3" ClipToBounds="True" Margin="0,0,6,0" VerticalAlignment="Center" BorderBrush="#CBD5E1" BorderThickness="0.5">
                                                <Image Source="/Resources/Flags/gb.webp" Width="18" Height="13" Stretch="UniformToFill"/>
                                            </Border>
                                            <TextBlock Text="EN" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnLangDE" Click="BtnLang_Click" Tag="de"
                                            ToolTip="Deutsch"
                                            Style="{StaticResource ExBtnGhostPill}" Height="28" Padding="7,0" FontSize="11" FontWeight="SemiBold">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border CornerRadius="3" ClipToBounds="True" Margin="0,0,6,0" VerticalAlignment="Center" BorderBrush="#CBD5E1" BorderThickness="0.5">
                                                <Image Source="/Resources/Flags/de.webp" Width="18" Height="13" Stretch="UniformToFill"/>
                                            </Border>
                                            <TextBlock Text="DE" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnLangAR" Click="BtnLang_Click" Tag="ar"
                                            ToolTip="اللغة العربية"
                                            Style="{StaticResource ExBtnGhostPill}" Height="28" Padding="7,0" FontSize="11" FontWeight="SemiBold">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border CornerRadius="3" ClipToBounds="True" Margin="0,0,6,0" VerticalAlignment="Center" BorderBrush="#CBD5E1" BorderThickness="0.5">
                                                <Image Source="/Resources/Flags/sa.webp" Width="18" Height="13" Stretch="UniformToFill"/>
                                            </Border>
                                            <TextBlock Text="عربي" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Window Control Buttons (Minimalist Smooth) -->
                            <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                                <Button x:Name="BtnMinimize" Content="─" Width="34" Height="32" Margin="2,0"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{StaticResource ExTextSecondary}" FontSize="13" Cursor="Hand"
                                        ToolTip="تصغير / Minimize"
                                        Click="BtnMinimize_Click"/>
                                <Button x:Name="BtnMaximize" Content="☐" Width="34" Height="32" Margin="2,0"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{StaticResource ExTextSecondary}" FontSize="13" Cursor="Hand"
                                        ToolTip="تكبير / Maximize"
                                        Click="BtnMaximize_Click"/>
                                <Button x:Name="BtnClose" Content="✕" Width="34" Height="32" Margin="2,0"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{StaticResource ExTextSecondary}" FontSize="12" Cursor="Hand"
                                        ToolTip="إغلاق / Close"
                                        Click="BtnClose_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Page Frame — Swapped by navigation -->
                <Frame x:Name="MainFrame" Grid.Row="2"
                       NavigationUIVisibility="Hidden"
                       Background="{StaticResource ExCanvasBg}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
