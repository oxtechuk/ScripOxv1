<Window x:Class="ScripOx.Desktop.Views.Dashboard.DashboardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScripOx — Executive CRM &amp; Data Hub"
        Width="1380" Height="860"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="16" ClipToBounds="True" Background="{StaticResource ExCanvasBg}"
            BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="240"/>   <!-- Sidebar -->
                <ColumnDefinition Width="*"/>                           <!-- Main Workspace -->
            </Grid.ColumnDefinitions>

            <!-- ── Left Sidebar (Hudson 8 & CRMEdge Hybrid) ─────── -->
            <Border Grid.Column="0" x:Name="SidebarBorder"
                    Background="{StaticResource ExSidebarBg}"
                    BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="0,0,1,0"
                    MouseEnter="Sidebar_MouseEnter" MouseLeave="Sidebar_MouseLeave">
                <DockPanel>

                    <!-- Top Branding -->
                    <StackPanel DockPanel.Dock="Top" x:Name="PanelLogo" Margin="20,24,20,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Geometric Icon with Lime Accent -->
                            <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource ExDarkObsidian}" Margin="0,0,12,0">
                                <Grid>
                                    <Ellipse Width="10" Height="10" Fill="{StaticResource ExAccentLime}"
                                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0"/>
                                    <TextBlock Text="S" Foreground="White" FontWeight="Bold" FontSize="18"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="ScripOx" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource ExTextPrimary}" FontFamily="{StaticResource ExPrimaryFont}"/>
                                <TextBlock Text="CRM &amp; Data Hub" FontSize="11" FontWeight="Medium"
                                           Foreground="{StaticResource ExTextSecondary}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Collapsed Mini Logo -->
                    <StackPanel DockPanel.Dock="Top" x:Name="PanelMiniLogo" Margin="0,24,0,24" HorizontalAlignment="Center" Visibility="Collapsed">
                        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource ExDarkObsidian}">
                            <Ellipse Width="10" Height="10" Fill="{StaticResource ExAccentLime}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Bottom: User Card -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <!-- User Profile Info Capsule -->
                        <Border x:Name="PanelUserInfo" Margin="14,0,14,18"
                                Background="{StaticResource ExCanvasBg}" CornerRadius="12" Padding="12,10"
                                BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <Border Width="34" Height="34" CornerRadius="17" Background="#E2E8F0" Margin="0,0,10,0">
                                    <TextBlock Text="AD" FontSize="12" FontWeight="Bold" Foreground="{StaticResource ExDarkObsidian}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtUserName" Text="Admin" FontSize="12"
                                               Foreground="{StaticResource ExTextPrimary}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtUserRole" Text="Super Admin" FontSize="10"
                                               Foreground="{StaticResource ExTextSecondary}"/>
                                </StackPanel>

                                <Button x:Name="BtnSignOut" Grid.Column="2" Content="Sign Out" Height="26"
                                        Style="{StaticResource ExBtnGhostPill}" FontSize="10" Padding="8,2"
                                        Click="BtnSignOut_Click"/>
                            </Grid>
                        </Border>

                        <!-- Mini Sign Out when sidebar collapsed -->
                        <Button x:Name="BtnMiniSignOut" Content="Out" Style="{StaticResource ExBtnGhostPill}"
                                Height="34" Width="34" HorizontalAlignment="Center" Margin="0,0,0,16"
                                Visibility="Collapsed" Click="BtnSignOut_Click" ToolTip="Sign Out"/>
                    </StackPanel>

                    <!-- Navigation Items List (Zero Emoji - Apple Style) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="10,0">
                            <Button Content="Dashboard"      Style="{StaticResource ExNavButton}" x:Name="BtnNavDashboard"  Click="Nav_Click" Tag="dashboard"/>
                            <Button Content="Companies"      Style="{StaticResource ExNavButton}" x:Name="BtnNavCompanies"  Click="Nav_Click" Tag="companies"/>
                            <Button Content="Sources"        Style="{StaticResource ExNavButton}" x:Name="BtnNavSources"    Click="Nav_Click" Tag="sources"/>
                            <Button Content="Jobs"           Style="{StaticResource ExNavButton}" x:Name="BtnNavJobs"       Click="Nav_Click" Tag="jobs"/>
                            <Button Content="Raw Records"    Style="{StaticResource ExNavButton}" x:Name="BtnNavRaw"        Click="Nav_Click" Tag="raw"/>
                            <Button Content="Map Explorer"  Style="{StaticResource ExNavButton}" x:Name="BtnNavMap"        Click="Nav_Click" Tag="map"/>
                            <Button Content="Exports"        Style="{StaticResource ExNavButton}" x:Name="BtnNavExports"    Click="Nav_Click" Tag="exports"/>
                            <Button Content="Extension"      Style="{StaticResource ExNavButton}" x:Name="BtnNavExtension" Click="Nav_Click" Tag="extension"/>
                            <Separator x:Name="SepNav" Background="{StaticResource ExBorderSubtle}" Margin="12,10"/>
                            <Button Content="Settings"      Style="{StaticResource ExNavButton}" x:Name="BtnNavSettings"   Click="Nav_Click" Tag="settings"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ── Main Content Area ────────────────────────────── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Update Banner (Auto height, collapsed when not active) -->
                    <RowDefinition Height="64"/>   <!-- Modern Topbar -->
                    <RowDefinition Height="*"/>    <!-- Active Page -->
                </Grid.RowDefinitions>

                <!-- ── Update Notification Banner (Dark Obsidian with Lime Accent) ── -->
                <Border x:Name="BannerUpdateNotification" Grid.Row="0"
                        Background="{StaticResource ExDarkObsidian}"
                        BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="0,0,0,1"
                        Padding="20,10" Visibility="Collapsed">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource ExAccentLime}" Margin="0,0,10,0"/>
                            <TextBlock x:Name="TxtBannerUpdateMessage"
                                       Text="A new version of ScripOx is available."
                                       Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="BtnBannerViewDetails" Content="View Update"
                                    Background="{StaticResource ExAccentLime}" Foreground="{StaticResource ExDarkObsidian}"
                                    FontWeight="Bold" FontSize="11" Height="28" Padding="14,0" Margin="0,0,10,0"
                                    BorderThickness="0" Cursor="Hand" Click="BtnBannerViewDetails_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="14"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button x:Name="BtnBannerDismiss" Content="✕" Width="26" Height="26"
                                    Background="Transparent" BorderThickness="0" Foreground="{StaticResource ExTextMuted}"
                                    FontSize="11" Cursor="Hand" Click="BtnBannerDismiss_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── Modern Executive Topbar (CRMEdge Style) ───── -->
                <Border Grid.Row="1" Background="{StaticResource ExHeaderBg}"
                        BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="Window_MouseLeftButtonDown">
                    <Grid Margin="20,0">
                        <!-- Left: Sidebar Toggle + Title -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnToggleSidebar" Content="☰" FontSize="16" FontWeight="SemiBold"
                                    Width="36" Height="36" Cursor="Hand" Background="{StaticResource ExCanvasBg}"
                                    BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="1"
                                    Foreground="{StaticResource ExTextSecondary}" Click="BtnToggleSidebar_Click" Margin="0,0,16,0"
                                    Style="{StaticResource ExBtnGhostPill}"/>
                            <TextBlock x:Name="TxtPageTitle"
                                       Text="Customer Movements" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource ExTextPrimary}" VerticalAlignment="Center"
                                       FontFamily="{StaticResource ExPrimaryFont}"/>
                        </StackPanel>

                        <!-- Middle: Search Input Pill (CRMEdge Style) -->
                        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="360"
                                Background="{StaticResource ExCanvasBg}" CornerRadius="20"
                                BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="1" Padding="12,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{StaticResource IconSearchGeom}" Fill="{StaticResource ExTextMuted}"
                                      Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtGlobalSearch" Text="Search companies, records, or pipelines..."
                                         Background="Transparent" BorderThickness="0" Foreground="{StaticResource ExTextSecondary}"
                                         FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Right: Actions + Markets + Controls -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            
                            <!-- Action Button (Black Pill Style) -->
                            <Button x:Name="BtnCreateRecord" Content="+ Create Record" Style="{StaticResource ExBtnBlackPill}"
                                    Height="36" Margin="0,0,14,0" Padding="16,0" FontSize="12"/>

                            <!-- Trilingual Flag Selector (EN 🇬🇧 / DE 🇩🇪 / AR 🇸🇦) -->
                            <Border Background="{StaticResource ExCanvasBg}" CornerRadius="17"
                                    BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="1"
                                    Padding="3" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnLangEN" Content="🇬🇧 EN" Click="BtnLang_Click" Tag="en"
                                            ToolTip="English"
                                            Style="{StaticResource ExBtnGhostPill}" Height="28" Padding="8,0" FontSize="11" FontWeight="SemiBold"/>
                                    <Button x:Name="BtnLangDE" Content="🇩🇪 DE" Click="BtnLang_Click" Tag="de"
                                            ToolTip="Deutsch"
                                            Style="{StaticResource ExBtnGhostPill}" Height="28" Padding="8,0" FontSize="11" FontWeight="SemiBold"/>
                                    <Button x:Name="BtnLangAR" Content="🇸🇦 عربي" Click="BtnLang_Click" Tag="ar"
                                            ToolTip="اللغة العربية"
                                            Style="{StaticResource ExBtnGhostPill}" Height="28" Padding="8,0" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>

                            <!-- Window Control Buttons (Minimalist Smooth) -->
                            <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                                <Button Content="─" Width="32" Height="32" Margin="3,0"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{StaticResource ExTextSecondary}" FontSize="13" Cursor="Hand"
                                        Click="BtnMinimize_Click"/>
                                <Button Content="☐" Width="32" Height="32" Margin="3,0"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{StaticResource ExTextSecondary}" FontSize="13" Cursor="Hand"
                                        Click="BtnMaximize_Click"/>
                                <Button Content="✕" Width="32" Height="32" Margin="3,0"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{StaticResource ExTextSecondary}" FontSize="12" Cursor="Hand"
                                        Click="BtnClose_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Page Frame — Swapped by navigation -->
                <Frame x:Name="MainFrame" Grid.Row="1"
                       NavigationUIVisibility="Hidden"
                       Background="{StaticResource ExCanvasBg}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
