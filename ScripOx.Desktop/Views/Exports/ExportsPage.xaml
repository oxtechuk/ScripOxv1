<Page x:Class="ScripOx.Desktop.Views.Exports.ExportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Exports &amp; Audiences Center"
      Background="{StaticResource ExCanvasBg}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28" MaxWidth="820" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Data Exports &amp; Ad Audiences Hub" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource ExTextPrimary}" Margin="0,0,0,6"/>
                <TextBlock Text="Synchronize qualified CRM leads directly with advertising platforms (Meta, Google) or generate compliance reports."
                           FontSize="12" Foreground="{StaticResource ExTextSecondary}" Margin="0,0,0,24"/>

                <!-- ── Card 1: Ad Platform & CRM Audience Sync ───────── -->
                <Border Style="{StaticResource ExCard}" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Digital Advertising &amp; Email Marketing Audiences"
                                           Foreground="{StaticResource ExTextPrimary}" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock Text="1-click exports formatted to exact platform specifications for lookalike and retargeting campaigns."
                                           Foreground="{StaticResource ExTextSecondary}" FontSize="12"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="{StaticResource ExStatusSuccessBg}" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                                <TextBlock Text="Ready for Meta &amp; Google" FontSize="10" FontWeight="Bold" Foreground="{StaticResource ExStatusSuccessText}"/>
                            </Border>
                        </Grid>

                        <Border Background="{StaticResource ExCanvasBg}" CornerRadius="10" Padding="14,10" Margin="0,0,0,16"
                                BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="1">
                            <CheckBox x:Name="ChkQualifiedOnly"
                                      Content="Targeting Filter: Export Qualified Leads Only (Interested / Deal Won) — مهتمين فقط"
                                      Foreground="{StaticResource ExTextPrimary}" FontWeight="SemiBold"
                                      IsChecked="True" FontSize="12"/>
                        </Border>

                        <!-- Platform Export Buttons Grid -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Meta Ads Button -->
                            <Border Grid.Column="0" Margin="0,0,8,0" Background="{StaticResource ExCanvasBg}" CornerRadius="12"
                                    BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="1" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Meta Ads (FB &amp; IG)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource ExTextPrimary}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Custom Audiences CSV with clean hashed phone &amp; email schema." FontSize="11" Foreground="{StaticResource ExTextSecondary}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                    <Button Content="Export Meta CSV" Style="{StaticResource ExBtnBlackPill}"
                                            Height="34" FontSize="11" Click="BtnExportMeta_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Google Ads Button -->
                            <Border Grid.Column="1" Margin="4,0,4,0" Background="{StaticResource ExCanvasBg}" CornerRadius="12"
                                    BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="1" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Google Ads" FontWeight="Bold" FontSize="13" Foreground="{StaticResource ExTextPrimary}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Customer Match CSV formatted for Search, YouTube &amp; Display." FontSize="11" Foreground="{StaticResource ExTextSecondary}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                    <Button Content="Export Google CSV" Style="{StaticResource ExBtnBlackPill}"
                                            Height="34" FontSize="11" Click="BtnExportGoogle_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Mailchimp / CRM Button -->
                            <Border Grid.Column="2" Margin="8,0,0,0" Background="{StaticResource ExCanvasBg}" CornerRadius="12"
                                    BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="1" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Email Marketing" FontWeight="Bold" FontSize="13" Foreground="{StaticResource ExTextPrimary}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Mailchimp, Brevo &amp; ActiveCampaign segmented contact list." FontSize="11" Foreground="{StaticResource ExTextSecondary}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                    <Button Content="Export Email CSV" Style="{StaticResource ExBtnBlackPill}"
                                            Height="34" FontSize="11" Click="BtnExportMarketing_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Card 2: Excel & Business Reporting Dossier ───── -->
                <Border Style="{StaticResource ExCard}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Excel &amp; GoBD Compliance Export" Foreground="{StaticResource ExTextPrimary}" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Text="Generate multi-sheet Excel spreadsheet with company dossiers and KPI summaries."
                                   Foreground="{StaticResource ExTextSecondary}" FontSize="12" Margin="0,0,0,16"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Status Filter" Foreground="{StaticResource ExTextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="CmbStatus" Width="260" Height="34" HorizontalAlignment="Left"
                                      Background="{StaticResource ExCanvasBg}" Foreground="{StaticResource ExTextPrimary}"
                                      BorderBrush="{StaticResource ExBorderSubtle}" DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                      VerticalContentAlignment="Center" FontSize="12"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Language Schema" Foreground="{StaticResource ExTextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="CmbLang" Width="260" Height="34" HorizontalAlignment="Left" SelectedIndex="0"
                                      Background="{StaticResource ExCanvasBg}" Foreground="{StaticResource ExTextPrimary}"
                                      BorderBrush="{StaticResource ExBorderSubtle}" VerticalContentAlignment="Center" FontSize="12">
                                <ComboBoxItem Content="English / German (LTR)"/>
                                <ComboBoxItem Content="Arabic / UAE Market (RTL)"/>
                            </ComboBox>
                        </Grid>

                        <CheckBox x:Name="ChkSummary" Content="Include Executive Portfolio Summary Sheet"
                                  Foreground="{StaticResource ExTextPrimary}" IsChecked="True" FontSize="12" Margin="0,0,0,18"/>

                        <Button Content="Generate Full Excel Dossier (.xlsx)" Style="{StaticResource ExBtnGhostPill}"
                                Height="36" Padding="20,0" HorizontalAlignment="Left" Click="BtnExport_Click"/>
                    </StackPanel>
                </Border>

                <!-- ── Card 3: Database Backup ──────────────────────── -->
                <Border Style="{StaticResource ExCard}">
                    <StackPanel>
                        <TextBlock Text="System Backup Archive" Foreground="{StaticResource ExTextPrimary}" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock Text="Create a standalone offline backup archive of your SQLite lead pipeline database."
                                   Foreground="{StaticResource ExTextSecondary}" FontSize="12" Margin="0,0,0,16"/>
                        <Button Content="Backup Database Archive (.db)" Style="{StaticResource ExBtnGhostPill}"
                                Height="36" Padding="18,0" HorizontalAlignment="Left" Click="BtnBackup_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
