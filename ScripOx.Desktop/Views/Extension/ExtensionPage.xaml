<Page x:Class="ScripOx.Desktop.Views.Extension.ExtensionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Extension Hub"
      Background="{StaticResource ExCanvasBg}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="680"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*" MaxWidth="360"/>
            </Grid.ColumnDefinitions>

            <!-- ══ LEFT COLUMN ════════════════════════════════════════ -->
            <StackPanel Grid.Column="0">

                <!-- Header -->
                <StackPanel Margin="0,0,0,24">
                    <TextBlock Text="Visual Extractor Hub"
                               FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource ExTextPrimary}"/>
                    <TextBlock Text="Link the ScripOx Chrome/Edge extension to your local desktop instance for interactive extraction."
                               FontSize="12" Foreground="{StaticResource ExTextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- API Status Banner (Apple Style Soft Tint) -->
                <Border x:Name="BannerApiStatus" CornerRadius="12"
                        Padding="16,14" Margin="0,0,0,24"
                        Background="{StaticResource ExSurfaceBg}"
                        BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="EllApiDot" Grid.Column="0"
                                 Width="10" Height="10" Fill="{StaticResource ExAccentLime}"
                                 VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtApiStatus"
                                       Text="Checking local service connection..."
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource ExTextPrimary}"/>
                            <TextBlock Text="http://127.0.0.1:8765/api/health"
                                       FontSize="11" Foreground="{StaticResource ExTextSecondary}"
                                       FontFamily="Consolas" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Refresh Link"
                                Style="{StaticResource ExBtnGhostPill}"
                                Height="32" Padding="14,0" Click="BtnRefreshApi_Click"/>
                    </Grid>
                </Border>

                <!-- Step 1: Browser Selection -->
                <TextBlock Text="Step 1 — Select Target Browser"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource ExTextPrimary}" Margin="0,0,0,12"/>

                <!-- Browser cards container -->
                <StackPanel x:Name="BrowserList" Margin="0,0,0,12"/>

                <!-- Selected browser indicator -->
                <Border x:Name="BdrSelectedBrowser" Visibility="Collapsed"
                        Background="{StaticResource ExSurfaceBg}" BorderBrush="{StaticResource ExBorderSubtle}"
                        BorderThickness="1" CornerRadius="12"
                        Padding="16,12" Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TxtSelectedIcon" FontSize="18"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="TxtSelectedName" FontSize="13"
                                   FontWeight="SemiBold" Foreground="{StaticResource ExTextPrimary}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text=" selected for installation" FontSize="13"
                                   Foreground="{StaticResource ExTextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Step 2: Install Action -->
                <TextBlock Text="Step 2 — Install &amp; Activate"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource ExTextPrimary}" Margin="0,8,0,12"/>

                <Button x:Name="BtnInstall"
                        Content="Open Browser Extensions Page"
                        Style="{StaticResource ExBtnBlackPill}"
                        Height="42" IsEnabled="False"
                        Click="BtnInstall_Click" Margin="0,0,0,14"/>

                <!-- Extension Folder Path Info -->
                <Border Style="{StaticResource ExCard}" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="Extension Directory" FontSize="11" FontWeight="Medium"
                                       Foreground="{StaticResource ExTextSecondary}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtExtPath" Text="Detecting..."
                                       FontSize="11" Foreground="{StaticResource ExTextPrimary}"
                                       FontFamily="Consolas" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Open Folder"
                                Style="{StaticResource ExBtnGhostPill}"
                                Height="32" Padding="14,0" Click="BtnOpenFolder_Click"
                                VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Result Message -->
                <Border x:Name="BdrResult" Visibility="Collapsed"
                        CornerRadius="12" Padding="16,14" Margin="0,14,0,0"
                        BorderThickness="1">
                    <TextBlock x:Name="TxtResult" FontSize="12"
                               Foreground="{StaticResource ExTextPrimary}" TextWrapping="Wrap"
                               LineHeight="20"/>
                </Border>

            </StackPanel>

            <!-- ══ RIGHT COLUMN ═══════════════════════════════════════ -->
            <StackPanel Grid.Column="2">

                <!-- Architecture & Flow Card -->
                <Border Style="{StaticResource ExCard}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Pipeline Architecture"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource ExTextPrimary}" Margin="0,0,0,16"/>

                        <!-- Step 1: Web Extension -->
                        <Border Background="{StaticResource ExCanvasBg}" CornerRadius="10" Padding="14,10"
                                BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Browser Extension" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource ExTextPrimary}"/>
                                <TextBlock Text="DOM element picker on active tab" FontSize="10"
                                           Foreground="{StaticResource ExTextSecondary}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="↓" FontSize="14" Foreground="{StaticResource ExTextMuted}"
                                   HorizontalAlignment="Center" Margin="0,6"/>

                        <!-- Step 2: FastAPI Service -->
                        <Border Background="{StaticResource ExCanvasBg}" CornerRadius="10" Padding="14,10"
                                BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Local FastAPI Gateway" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource ExTextPrimary}"/>
                                <TextBlock Text="Port 8765 high-speed IPC bridge" FontSize="10"
                                           Foreground="{StaticResource ExTextSecondary}" FontFamily="Consolas"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="↓" FontSize="14" Foreground="{StaticResource ExTextMuted}"
                                   HorizontalAlignment="Center" Margin="0,6"/>

                        <!-- Step 3: Desktop App -->
                        <Border Background="{StaticResource ExCanvasBg}" CornerRadius="10" Padding="14,10"
                                BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="ScripOx Desktop Core" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource ExTextPrimary}"/>
                                <TextBlock Text="Structured SQLite/PostgreSQL storage" FontSize="10"
                                           Foreground="{StaticResource ExTextSecondary}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Instructions / Steps Card -->
                <Border Style="{StaticResource ExCard}">
                    <StackPanel>
                        <TextBlock Text="Activation Steps"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource ExTextPrimary}" Margin="0,0,0,14"/>

                        <StackPanel x:Name="StepsPanel"/>

                        <Separator Background="{StaticResource ExBorderSubtle}" Margin="0,16"/>

                        <TextBlock Text="Keyboard Shortcuts"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource ExTextPrimary}" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Element Picker"
                                       FontSize="12" Foreground="{StaticResource ExTextSecondary}"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="{StaticResource ExCanvasBg}"
                                    CornerRadius="6" Padding="8,3" BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="1">
                                <TextBlock Text="Alt+Shift+P" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource ExTextPrimary}" FontFamily="Consolas"/>
                            </Border>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Toggle Sidebar"
                                       FontSize="12" Foreground="{StaticResource ExTextSecondary}"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="{StaticResource ExCanvasBg}"
                                    CornerRadius="6" Padding="8,3" BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="1">
                                <TextBlock Text="Alt+Shift+S" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource ExTextPrimary}" FontFamily="Consolas"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
