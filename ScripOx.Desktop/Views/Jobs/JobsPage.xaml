<Page x:Class="ScripOx.Desktop.Views.Jobs.JobsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Extraction Jobs"
      Background="{StaticResource ExCanvasBg}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- New Extraction Card -->
            <RowDefinition Height="*"/>     <!-- History Card -->
        </Grid.RowDefinitions>

        <!-- ── New Extraction Pipeline Card (Apple Style) ─────── -->
        <Border Grid.Row="0" Style="{StaticResource ExCard}" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Start Extraction Pipeline" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource ExTextPrimary}" Margin="0,0,0,16"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Source Selector -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Source Gateway" FontSize="11" FontWeight="Medium" Foreground="{StaticResource ExTextSecondary}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbSource" Width="180" Height="36" SelectedIndex="0"
                                  Background="{StaticResource ExCanvasBg}" Foreground="{StaticResource ExTextPrimary}"
                                  BorderBrush="{StaticResource ExBorderSubtle}" FontSize="12" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="Google Maps Places"/>
                            <ComboBoxItem Content="CSV / Excel Pipeline"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Keyword Input -->
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="Search Keyword" FontSize="11" FontWeight="Medium" Foreground="{StaticResource ExTextSecondary}" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtKeyword" Width="200" Height="36" Style="{StaticResource ExSearchBox}"
                                 VerticalContentAlignment="Center" FontSize="12"/>
                    </StackPanel>

                    <!-- Location Input -->
                    <StackPanel Grid.Column="2" Margin="0,0,16,0">
                        <TextBlock Text="Target Location / Market" FontSize="11" FontWeight="Medium" Foreground="{StaticResource ExTextSecondary}" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtLocation" Width="200" Height="36" Style="{StaticResource ExSearchBox}"
                                 VerticalContentAlignment="Center" FontSize="12"/>
                    </StackPanel>

                    <!-- Launch Button -->
                    <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                        <Button Content="Launch Job" Style="{StaticResource ExBtnBlackPill}"
                                Height="36" Padding="20,0" Click="BtnStartJob_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ── Job History & Status DataGrid Card ────────────── -->
        <Border Grid.Row="1" Style="{StaticResource ExCard}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="20,16" BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBlock Text="Pipeline History &amp; Status" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource ExTextPrimary}"/>
                        <TextBlock Text="Live monitoring of automated scrapers" FontSize="11"
                                   Foreground="{StaticResource ExTextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <DataGrid x:Name="DgJobs" Grid.Row="1" Style="{StaticResource ExDataGrid}"
                          ColumnHeaderStyle="{StaticResource ExDataGridHeader}"
                          AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Job ID" Binding="{Binding Id}" Width="80"/>
                        <DataGridTextColumn Header="Source" Binding="{Binding SourceId}" Width="120"/>
                        <DataGridTemplateColumn Header="Status" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" Background="{StaticResource ExStatusInfoBg}">
                                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource ExStatusInfoText}" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Progress" Binding="{Binding ProgressPct}" Width="90"/>
                        <DataGridTextColumn Header="Records Found" Binding="{Binding TotalFound}" Width="120"/>
                        <DataGridTextColumn Header="Records Saved" Binding="{Binding TotalSaved}" Width="120"/>
                        <DataGridTextColumn Header="Timestamp" Binding="{Binding StartedAt}" Width="160"/>
                        <DataGridTemplateColumn Header="Action" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Cancel" Style="{StaticResource ExBtnGhostPill}" Padding="10,2"
                                            Click="BtnCancelJob_Click" Tag="{Binding Id}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Page>
