<Page x:Class="ScripOx.Desktop.Views.RawRecords.RawRecordsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="السجلات والبيانات الخام المستخرجة"
      Background="{StaticResource ExCanvasBg}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Search & Clean Bar -->
            <RowDefinition Height="*"/>     <!-- Table Card -->
            <RowDefinition Height="Auto"/>  <!-- Pagination -->
        </Grid.RowDefinitions>

        <!-- ── Top Search & Actions Bar ─────────────────────── -->
        <Border Grid.Row="0" Margin="0,0,0,12" Background="{StaticResource ExSurfaceBg}"
                CornerRadius="6" Padding="14,10" BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="1">
            <WrapPanel>
                <!-- Left: Filter & Bulk Data Actions -->
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,10">
                    <!-- Search Input -->
                    <Border Width="220" Height="34" Background="{StaticResource ExCanvasBg}" CornerRadius="4"
                            BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="1" Padding="10,0" Margin="0,0,8,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IconSearchGeom}" Fill="{StaticResource ExTextMuted}"
                                  Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtSearch" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource ExTextPrimary}" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Button x:Name="BtnFilter" Content="تصفية 🔍" Click="BtnFilter_Click" Style="{StaticResource ExBtnGhostPill}"
                            Height="34" Padding="14,0" Margin="0,0,6,0"/>

                    <Button x:Name="BtnResetFilter" Content="مسح الفلتر ✕" Click="BtnResetFilter_Click" Style="{StaticResource ExBtnGhostPill}"
                            Height="34" Padding="12,0" Margin="0,0,8,0"/>

                    <Button x:Name="BtnToggleSelectAll" Content="تحديد الكل" Click="BtnToggleSelectAll_Click" Style="{StaticResource ExBtnGhostPill}"
                            Height="34" Padding="12,0" Margin="0,0,8,0"/>
                            
                    <!-- Import JSON Button -->
                    <Button x:Name="BtnImportJson" Content="استيراد ملف JSON 📥" Click="BtnImportJson_Click" Style="{StaticResource ExBtnGhostPill}"
                            Height="34" Padding="12,0" Margin="0,0,8,0"/>

                    <!-- Delete Selected Raw Records -->
                    <Button x:Name="BtnDeleteSelectedRaw" Content="حذف المحدد 🗑️" Click="BtnDeleteSelectedRaw_Click" Style="{StaticResource ExBtnDangerPill}"
                            Height="34" Padding="12,0" Margin="0,0,6,0"/>

                    <!-- Wipe Entire Raw Table -->
                    <Button x:Name="BtnClearAllRaw" Content="تفريغ الجدول ⚠️" Click="BtnClearAllRaw_Click" Style="{StaticResource ExBtnDangerPill}"
                            Height="34" Padding="12,0"/>
                </WrapPanel>

                <!-- Right: Clean, Classify, Rate & Transfer to CRM -->
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                    <!-- Segment (الشريحة) -->
                    <TextBlock x:Name="LblSegment" Text="الشريحة:" Foreground="{StaticResource ExTextSecondary}" FontSize="11.5"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbTargetSegment" Width="135" Height="32" Margin="0,0,8,0" IsEditable="True">
                        <ComboBoxItem Content="عميل مميز VIP" IsSelected="True"/>
                        <ComboBoxItem Content="مطاعم وكافيهات"/>
                        <ComboBoxItem Content="شركات تسويق ودعاية"/>
                        <ComboBoxItem Content="عقارات وتطوير"/>
                        <ComboBoxItem Content="أطباء ومستشفيات"/>
                        <ComboBoxItem Content="تجارة ومستوردين"/>
                        <ComboBoxItem Content="خدمات وأعمال"/>
                    </ComboBox>

                    <!-- Rating / Priority (التقييم) -->
                    <TextBlock x:Name="LblRating" Text="التقييم:" Foreground="{StaticResource ExTextSecondary}" FontSize="11.5"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbTargetPriority" Width="110" Height="32" Margin="0,0,8,0">
                        <ComboBoxItem Content="★★★ أولوية عالية" Tag="high" IsSelected="True"/>
                        <ComboBoxItem Content="★★ أولوية متوسطة" Tag="medium"/>
                        <ComboBoxItem Content="★ أولوية منخفضة" Tag="low"/>
                    </ComboBox>

                    <!-- Status / Classification (التصنيف) -->
                    <TextBlock x:Name="LblStatus" Text="الحالة:" Foreground="{StaticResource ExTextSecondary}" FontSize="11.5"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbTargetStatus" Width="115" Height="32" Margin="0,0,10,0">
                        <ComboBoxItem Content="جديد (New)" Tag="1" IsSelected="True"/>
                        <ComboBoxItem Content="مهتم (Interested)" Tag="2"/>
                        <ComboBoxItem Content="متابعة (Follow-up)" Tag="3"/>
                        <ComboBoxItem Content="تعاقد (Won)" Tag="4"/>
                    </ComboBox>

                    <Button x:Name="BtnClean" Content="نقل إلى الشركات المعتمدة CRM ➔" Click="BtnClean_Click" Style="{StaticResource ExBtnBlackPill}"
                            Height="32" Padding="14,0" FontSize="11.5"/>
                </WrapPanel>
            </WrapPanel>
        </Border>

        <!-- ── Main DataGrid Card ───────────────────────────── -->
        <Border Grid.Row="1" Style="{StaticResource ExCard}" Padding="0" CornerRadius="6">
            <DataGrid Grid.Row="1" x:Name="DgRawRecords" Style="{StaticResource ExDataGrid}"
                      ColumnHeaderStyle="{StaticResource ExDataGridHeader}"
                      AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <!-- Interactive 1-click CheckBox for individual selection (تحديد بالواحد) -->
                    <DataGridTemplateColumn Width="42">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Click="RowCheckBox_Click"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="المعرف" Binding="{Binding Id}" Width="55"/>
                    <DataGridTextColumn Header="اسم الشركة" Binding="{Binding Name}" Width="1.8*"/>
                    <DataGridTextColumn Header="التصنيف / الفئة" Binding="{Binding Category}" Width="1.2*"/>
                    <DataGridTemplateColumn Header="التقييم" Width="95">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RatingDisplay}" Foreground="#D97706" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="هاتف الاتصال" Binding="{Binding Phone}" Width="125"/>
                    <DataGridTextColumn Header="البريد الإلكتروني" Binding="{Binding Email}" Width="150"/>
                    <DataGridTextColumn Header="الموقع الإلكتروني" Binding="{Binding Website}" Width="160"/>
                    <DataGridTextColumn Header="العنوان" Binding="{Binding Address}" Width="2*"/>
                    <DataGridTemplateColumn Header="الحالة" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="3" Padding="8,2" Background="{StaticResource ExStatusWarningBg}" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource ExStatusWarningText}" FontSize="10.5" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ── Pagination ───────────────────────────────────── -->
        <Border Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="‹ السابق" x:Name="BtnPrev" Click="BtnPrev_Click" Style="{StaticResource ExBtnGhostPill}"
                        Height="30" Padding="14,0" Margin="0,0,10,0"/>
                <TextBlock x:Name="TxtPageInfo" Text="صفحة 1 من 1" Foreground="{StaticResource ExTextSecondary}"
                           FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="التالي ›" x:Name="BtnNext" Click="BtnNext_Click" Style="{StaticResource ExBtnGhostPill}"
                        Height="30" Padding="14,0" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
