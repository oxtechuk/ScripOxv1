<Page x:Class="ScripOx.Desktop.Views.RawRecords.RawRecordsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Raw Data Records"
      Background="{StaticResource ExCanvasBg}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Search & Clean Bar -->
            <RowDefinition Height="*"/>     <!-- Table Card -->
            <RowDefinition Height="Auto"/>  <!-- Pagination -->
        </Grid.RowDefinitions>

        <!-- ── Top Search & Actions Bar ─────────────────────── -->
        <Border Grid.Row="0" Margin="0,0,0,20" Background="{StaticResource ExSurfaceBg}"
                CornerRadius="14" Padding="16,12" BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Pill Search Input -->
                    <Border Width="240" Background="{StaticResource ExCanvasBg}" CornerRadius="18"
                            BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="1" Padding="12,6" Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IconSearchGeom}" Fill="{StaticResource ExTextMuted}"
                                  Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtSearch" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource ExTextPrimary}" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Button x:Name="BtnFilter" Content="Filter" Click="BtnFilter_Click" Style="{StaticResource ExBtnGhostPill}"
                            Height="34" Padding="14,0" Margin="0,0,10,0"/>

                    <Button x:Name="BtnToggleSelectAll" Content="Select All" Click="BtnToggleSelectAll_Click" Style="{StaticResource ExBtnGhostPill}"
                            Height="34" Padding="12,0"/>
                </StackPanel>

                <!-- Clean, Classify, Rate & Transfer to CRM -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Segment (الشريحة) -->
                    <TextBlock x:Name="LblSegment" Text="Segment:" Foreground="{StaticResource ExTextSecondary}" FontSize="11"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbTargetSegment" Width="140" Height="34" Margin="0,0,10,0" IsEditable="True"
                              Background="{StaticResource ExCanvasBg}" Foreground="{StaticResource ExTextPrimary}"
                              BorderBrush="{StaticResource ExBorderSubtle}" VerticalContentAlignment="Center" FontSize="11">
                        <ComboBoxItem Content="VIP Prospect" IsSelected="True"/>
                        <ComboBoxItem Content="مطاعم وكافيهات"/>
                        <ComboBoxItem Content="شركات تسويق ودعاية"/>
                        <ComboBoxItem Content="عقارات وتطوير"/>
                        <ComboBoxItem Content="أطباء ومستشفيات"/>
                        <ComboBoxItem Content="تجارة ومستوردين"/>
                        <ComboBoxItem Content="خدمات وأعمال"/>
                    </ComboBox>

                    <!-- Rating / Priority (التقييم) -->
                    <TextBlock x:Name="LblRating" Text="Rating:" Foreground="{StaticResource ExTextSecondary}" FontSize="11"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbTargetPriority" Width="110" Height="34" Margin="0,0,10,0"
                              Background="{StaticResource ExCanvasBg}" Foreground="{StaticResource ExTextPrimary}"
                              BorderBrush="{StaticResource ExBorderSubtle}" VerticalContentAlignment="Center" FontSize="11">
                        <ComboBoxItem Content="★★★ High" Tag="high" IsSelected="True"/>
                        <ComboBoxItem Content="★★ Medium" Tag="medium"/>
                        <ComboBoxItem Content="★ Low" Tag="low"/>
                    </ComboBox>

                    <!-- Status / Classification (التصنيف) -->
                    <TextBlock x:Name="LblStatus" Text="Status:" Foreground="{StaticResource ExTextSecondary}" FontSize="11"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbTargetStatus" Width="115" Height="34" Margin="0,0,12,0"
                              Background="{StaticResource ExCanvasBg}" Foreground="{StaticResource ExTextPrimary}"
                              BorderBrush="{StaticResource ExBorderSubtle}" VerticalContentAlignment="Center" FontSize="11">
                        <ComboBoxItem Content="New / جديد" Tag="1" IsSelected="True"/>
                        <ComboBoxItem Content="Interested / مهتم" Tag="2"/>
                        <ComboBoxItem Content="Follow-up / متابعة" Tag="3"/>
                        <ComboBoxItem Content="Won / تعاقد" Tag="4"/>
                    </ComboBox>

                    <Button x:Name="BtnClean" Content="Clean &amp; Intake to CRM" Click="BtnClean_Click" Style="{StaticResource ExBtnBlackPill}"
                            Height="36" Padding="16,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Main DataGrid Card ───────────────────────────── -->
        <Border Grid.Row="1" Style="{StaticResource ExCard}" Padding="0">
            <DataGrid Grid.Row="1" x:Name="DgRawRecords" Style="{StaticResource ExDataGrid}"
                      ColumnHeaderStyle="{StaticResource ExDataGridHeader}"
                      AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Select" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65"/>
                    <DataGridTextColumn Header="Business Name" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="Category / Segment" Binding="{Binding Category}" Width="1.2*"/>
                    <DataGridTextColumn Header="Rating" Binding="{Binding RatingDisplay}" Width="95"/>
                    <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="130"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="150"/>
                    <DataGridTextColumn Header="Website" Binding="{Binding Website}" Width="150"/>
                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="2*"/>
                    <DataGridTemplateColumn Header="Status" Width="105">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource ExStatusWarningBg}" CornerRadius="12" Padding="10,4" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource ExStatusWarningText}" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ── Bottom Pagination ────────────────────────────── -->
        <Border Grid.Row="2" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="&lt; Prev" x:Name="BtnPrev" Click="BtnPrev_Click" Style="{StaticResource ExBtnGhostPill}"
                        Height="32" Padding="14,0" Margin="0,0,12,0"/>
                <TextBlock x:Name="TxtPageInfo" Text="Page 1 of 1" Foreground="{StaticResource ExTextSecondary}"
                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="Next &gt;" x:Name="BtnNext" Click="BtnNext_Click" Style="{StaticResource ExBtnGhostPill}"
                        Height="32" Padding="14,0" Margin="12,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
