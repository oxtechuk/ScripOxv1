<Page x:Class="ScripOx.Desktop.Views.Settings.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="System Settings"
      Background="{StaticResource ExCanvasBg}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28" MaxWidth="760" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock x:Name="TxtSettingsTitle" Text="System Settings &amp; Preferences" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource ExTextPrimary}" Margin="0,0,0,6"/>
                <TextBlock x:Name="TxtSettingsSubtitle" Text="Configure market compliance standards, regional formats, and API connections."
                           FontSize="12" Foreground="{StaticResource ExTextSecondary}" Margin="0,0,0,24"/>

                <!-- Market & Compliance Card -->
                <Border Style="{StaticResource ExCard}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock x:Name="TxtMarketTitle" Text="Market Localization" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource ExTextPrimary}" Margin="0,0,0,16"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="TxtGdprTitle" Text="German DSGVO / GDPR Compliance Mode" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource ExTextPrimary}"/>
                                <TextBlock x:Name="TxtGdprDesc" Text="Enforces data erasure and privacy audit trail protocols" FontSize="11" Foreground="{StaticResource ExTextSecondary}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="True" VerticalAlignment="Center"/>
                        </Grid>

                        <Separator Background="{StaticResource ExBorderSubtle}" Margin="0,8,0,14"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="TxtFtaTitle" Text="UAE FTA &amp; TRN Invoicing Mode" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource ExTextPrimary}"/>
                                <TextBlock x:Name="TxtFtaDesc" Text="Auto-validates 15-digit TRN tax identification numbers" FontSize="11" Foreground="{StaticResource ExTextSecondary}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="True" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- API Connectivity Card -->
                <Border Style="{StaticResource ExCard}">
                    <StackPanel>
                        <TextBlock x:Name="TxtApiTitle" Text="Engine &amp; Service Endpoints" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource ExTextPrimary}" Margin="0,0,0,16"/>

                        <TextBlock x:Name="TxtApiPortLbl" Text="FastAPI Bridge Service Port" FontSize="11" FontWeight="Medium"
                                   Foreground="{StaticResource ExTextSecondary}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBox x:Name="TxtApiPort" Text="8765" Width="140" HorizontalAlignment="Left" Style="{StaticResource ExSearchBox}"
                                     Height="36" Margin="0,0,10,0"/>
                            <Button x:Name="BtnRestartServer" Content="Save &amp; Restart Server"
                                    Style="{StaticResource ExBtnBlackPill}" Height="36" Padding="16,0" FontSize="12"
                                    Click="BtnRestartServer_Click"/>
                            <Button x:Name="BtnTestConnection" Content="Test Connection"
                                    Style="{StaticResource ExBtnSecondary}" Height="36" Padding="16,0" FontSize="12" Margin="10,0,0,0"
                                    Click="BtnTestConnection_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtApiStatus" Text="Status: Unknown" FontSize="12" Foreground="{StaticResource ExTextSecondary}" Margin="0,0,0,16"/>

                        <TextBlock x:Name="TxtCurrencyLbl" Text="Primary Currency Schema" FontSize="11" FontWeight="Medium"
                                   Foreground="{StaticResource ExTextSecondary}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbCurrency" Width="200" HorizontalAlignment="Left" Height="36" SelectedIndex="0"
                                  Background="{StaticResource ExCanvasBg}" Foreground="{StaticResource ExTextPrimary}"
                                  BorderBrush="{StaticResource ExBorderSubtle}" FontSize="12" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="AED (UAE Dirham)"/>
                            <ComboBoxItem Content="EUR (€ Euro / DACH)"/>
                            <ComboBoxItem Content="USD ($ US Dollar)"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Software Updates & GitHub Card -->
                <Border Style="{StaticResource ExCard}" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock x:Name="TxtUpdatesTitle" Text="Software Updates &amp; GitHub Releases" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource ExTextPrimary}" Margin="0,0,0,16"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="TxtAutoUpdateTitle" Text="Check for updates automatically on startup" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource ExTextPrimary}"/>
                                <TextBlock x:Name="TxtAutoUpdateDesc" Text="Notifies you whenever a new release is published to GitHub" FontSize="11"
                                           Foreground="{StaticResource ExTextSecondary}"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkAutoUpdate" Grid.Column="1" IsChecked="True" VerticalAlignment="Center"
                                      Checked="ChkAutoUpdate_Changed" Unchecked="ChkAutoUpdate_Changed"/>
                        </Grid>

                        <Separator Background="{StaticResource ExBorderSubtle}" Margin="0,4,0,14"/>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,0">
                            <Button x:Name="BtnCheckUpdates" Content="Check for Updates Now"
                                    Style="{StaticResource ExBtnBlackPill}" Height="36" Padding="18,0" FontSize="12"
                                    Click="BtnCheckUpdates_Click"/>
                            <TextBlock x:Name="TxtUpdateStatus" Text="Current Version: v1.0.0"
                                       FontSize="12" Foreground="{StaticResource ExTextSecondary}"
                                       VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Development, Engineering & Support Card (OX Tech) -->
                <Border Style="{StaticResource ExCard}" Margin="0,20,0,24">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="TxtSupportTitle" Text="فريق التطوير والدعم الفني / Engineering &amp; Support" FontSize="15" FontWeight="Bold"
                                           Foreground="{StaticResource ExTextPrimary}"/>
                                <TextBlock x:Name="TxtSupportSub" Text="تم التطوير والإصلاح من قبل OX Tech" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource ExAccentLimeHover}" Margin="0,4,0,0"/>
                            </StackPanel>
                            
                            <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="4" Padding="10,4" VerticalAlignment="Top"
                                    BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="1">
                                <TextBlock Text="OX TECH" FontSize="11" FontWeight="Bold" Foreground="{StaticResource ExDarkObsidian}"/>
                            </Border>
                        </Grid>

                        <TextBlock x:Name="TxtSupportDesc" Text="للدعم الفني والتواصل المباشر مع فريق التطوير والاستفسارات التقنية:"
                                   FontSize="12" Foreground="{StaticResource ExTextSecondary}" Margin="0,0,0,14"/>

                        <Separator Background="{StaticResource ExBorderSubtle}" Margin="0,0,0,14"/>

                        <!-- Action / Contact Buttons -->
                        <WrapPanel Orientation="Horizontal">
                            <!-- Website Link Button -->
                            <Button x:Name="BtnOxTechWebsite" Style="{StaticResource ExBtnSecondary}" Height="34" Padding="14,0" Margin="0,0,10,10"
                                    Cursor="Hand" Click="BtnOxTechWebsite_Click" ToolTip="زيارة موقعنا الرسمي">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🌐 " FontSize="12"/>
                                    <TextBlock x:Name="TxtWebBtnText" Text="oxtech.uk" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                            </Button>

                            <!-- WhatsApp Direct Contact Button -->
                            <Button x:Name="BtnOxTechWhatsApp" Style="{StaticResource ExBtnSecondary}" Height="34" Padding="14,0" Margin="0,0,10,10"
                                    Cursor="Hand" Click="BtnOxTechWhatsApp_Click" ToolTip="محادثة فورية عبر واتساب">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="💬 " FontSize="12"/>
                                    <TextBlock x:Name="TxtWaBtnText" Text="WhatsApp: +201008616682" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                            </Button>

                            <!-- Direct Call Button -->
                            <Button x:Name="BtnOxTechCall" Style="{StaticResource ExBtnSecondary}" Height="34" Padding="14,0" Margin="0,0,10,10"
                                    Cursor="Hand" Click="BtnOxTechCall_Click" ToolTip="اتصال هاتفي مباشر">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📞 " FontSize="12"/>
                                    <TextBlock x:Name="TxtCallBtnText" Text="+201008616682" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
