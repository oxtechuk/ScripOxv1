<Page x:Class="ScripOx.Desktop.Views.Sources.SourcesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Data Sources &amp; Visual Scripts"
      Background="{StaticResource ExCanvasBg}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Data Sources &amp; Visual Scripts"
                           FontSize="24" FontWeight="Bold" Foreground="{StaticResource ExTextPrimary}"/>
                <TextBlock Text="Active visual selector configurations and schemas generated by the browser extension."
                           FontSize="12" Foreground="{StaticResource ExTextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>

            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                    Content="Refresh Sources" Style="{StaticResource ExBtnGhostPill}"
                    Padding="16,0" Height="34" Click="BtnRefresh_Click"/>
        </Grid>

        <!-- Main content area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEFT: Sources list ──────────────────────────────── -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="TxtNoSources" Text="No sources or scripts detected. Use the browser extension to capture page schemas."
                               FontSize="13" Foreground="{StaticResource ExTextSecondary}" HorizontalAlignment="Center" Margin="0,40,0,0"
                               Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center"/>

                    <ItemsControl x:Name="SourcesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ExCard}" Padding="18,14" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Info -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="15"
                                                       FontWeight="Bold" Foreground="{StaticResource ExTextPrimary}"/>
                                            <TextBlock Text="{Binding BaseUrl}" FontSize="11"
                                                       Foreground="{StaticResource ExTextSecondary}" Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Border Background="{StaticResource ExStatusInfoBg}" CornerRadius="10" Padding="8,3" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Connector}" FontSize="10"
                                                               Foreground="{StaticResource ExStatusInfoText}" FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock Text="{Binding CreatedAt, StringFormat='Created: {0:yyyy-MM-dd HH:mm}'}"
                                                           FontSize="11" Foreground="{StaticResource ExTextMuted}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Action buttons -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Inspect" Style="{StaticResource ExBtnBlackPill}"
                                                    Padding="14,0" Height="32" Margin="0,0,8,0" Click="BtnViewConfig_Click"
                                                    Tag="{Binding}"/>
                                            <Button Content="Delete" Style="{StaticResource ExBtnGhostPill}"
                                                    Padding="12,0" Height="32" Click="BtnDelete_Click"
                                                    Tag="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ── RIGHT: Config Inspector Panel ────────────────────── -->
            <Border Grid.Column="2" Style="{StaticResource ExCard}">
                <Grid>
                    <!-- Empty State -->
                    <StackPanel x:Name="PanelEmptyInspector" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Select a script on the left to inspect selector configurations."
                                   FontSize="12" Foreground="{StaticResource ExTextSecondary}"
                                   TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Config Details -->
                    <Grid x:Name="PanelConfigDetails" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock x:Name="TxtInspectorTitle" Text="Script Schema"
                                       FontSize="16" FontWeight="Bold" Foreground="{StaticResource ExTextPrimary}"/>
                            <TextBlock x:Name="TxtInspectorUrl" Text="https://..."
                                       FontSize="11" Foreground="{StaticResource ExTextSecondary}" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                            <!-- Selectors -->
                            <TabItem Header="Selectors" FontSize="12">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="CSS Selector" FontSize="11" Foreground="{StaticResource ExTextSecondary}"/>
                                        <Border Background="{StaticResource ExCanvasBg}" CornerRadius="8" Padding="10,8" Margin="0,4,0,12"
                                                BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="1">
                                            <TextBox x:Name="TxtBestSelector" Text="body > div"
                                                     Background="Transparent" BorderThickness="0"
                                                     Foreground="{StaticResource ExTextPrimary}" FontFamily="Consolas" FontSize="11"
                                                     IsReadOnly="True" TextWrapping="Wrap"/>
                                        </Border>

                                        <TextBlock Text="XPath" FontSize="11" Foreground="{StaticResource ExTextSecondary}"/>
                                        <Border Background="{StaticResource ExCanvasBg}" CornerRadius="8" Padding="10,8" Margin="0,4,0,0"
                                                BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="1">
                                            <TextBox x:Name="TxtXPath" Text="//div"
                                                     Background="Transparent" BorderThickness="0"
                                                     Foreground="{StaticResource ExTextPrimary}" FontFamily="Consolas" FontSize="11"
                                                     IsReadOnly="True" TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- Field Mappings -->
                            <TabItem Header="Field Mappings" FontSize="12">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Mapped Fields Schema" FontSize="11" Foreground="{StaticResource ExTextSecondary}" Margin="0,0,0,8"/>
                                        <StackPanel x:Name="PanelFieldMappings"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
