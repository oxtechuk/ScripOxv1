<Page x:Class="ScripOx.Desktop.Views.Sources.SourcesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="مصادر البيانات وسكربتات الاستخراج"
      Background="{StaticResource ExCanvasBg}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock x:Name="TxtHeaderTitle" Text="مصادر البيانات وسكربتات الاستخراج"
                           FontSize="20" FontWeight="Bold" Foreground="{StaticResource ExTextPrimary}"/>
                <TextBlock x:Name="TxtHeaderSubtitle" Text="المصادر المفعلة وسكربتات التحديد المرئي التي تم التقاطها عبر إضافة المتصفح."
                           FontSize="11.5" Foreground="{StaticResource ExTextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>

            <Button x:Name="BtnRefresh" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Content="🔄 تحديث المصادر" Style="{StaticResource ExBtnGhostPill}"
                    Padding="14,0" Height="32" Click="BtnRefresh_Click"/>
        </Grid>

        <!-- Main content area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEFT: Sources list ──────────────────────────────── -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="TxtNoSources" Text="لا توجد مصادر أو سكربتات مكتشفة حالياً. استخدم إضافة المتصفح لالتقاط وتحديد بيانات الصفحات."
                               FontSize="12.5" Foreground="{StaticResource ExTextSecondary}" HorizontalAlignment="Center" Margin="0,40,0,0"
                               Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center"/>

                    <ItemsControl x:Name="SourcesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ExCard}" Padding="16,12" Margin="0,0,0,10" CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Info -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14"
                                                       FontWeight="Bold" Foreground="{StaticResource ExTextPrimary}"/>
                                            <TextBlock Text="{Binding BaseUrl}" FontSize="11"
                                                       Foreground="{StaticResource ExTextSecondary}" Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Border Background="#F1F5F9" CornerRadius="3" Padding="8,2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Type}" FontSize="10" FontWeight="SemiBold" Foreground="#475569"/>
                                                </Border>
                                                <TextBlock Text="{Binding UpdatedAtDisplay}" FontSize="10.5"
                                                           Foreground="{StaticResource ExTextMuted}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Inspect Button -->
                                        <Button Grid.Column="1" Content="{Binding InspectButtonText}" Style="{StaticResource ExBtnGhostPill}"
                                                Height="30" Padding="12,0" FontSize="11" VerticalAlignment="Center"
                                                Click="BtnViewConfig_Click" Tag="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ── RIGHT: Config Inspector Panel ────────────────────── -->
            <Border Grid.Column="2" Style="{StaticResource ExCard}" CornerRadius="6">
                <Grid>
                    <!-- Empty State -->
                    <StackPanel x:Name="PanelEmptyInspector" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtEmptyInspectorMsg" Text="اختر مصدراً من القائمة على اليمين لمعاينة عناصر ومحددات الاستخراج."
                                   FontSize="12" Foreground="{StaticResource ExTextSecondary}"
                                   TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Config Details -->
                    <Grid x:Name="PanelConfigDetails" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock x:Name="TxtInspectorTitle" Text="مخطط السكربت"
                                       FontSize="15" FontWeight="Bold" Foreground="{StaticResource ExTextPrimary}"/>
                            <TextBlock x:Name="TxtInspectorUrl" Text="https://..."
                                       FontSize="11" Foreground="{StaticResource ExTextSecondary}" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                            <!-- Selectors -->
                            <TabItem x:Name="TabSelectors" Header="محددات CSS &amp; XPath" FontSize="11.5">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="LblCssSelector" Text="محدد CSS (CSS Selector):" FontSize="11" Foreground="{StaticResource ExTextSecondary}"/>
                                        <Border Background="{StaticResource ExCanvasBg}" CornerRadius="4" Padding="10,8" Margin="0,4,0,10"
                                                BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="1">
                                            <TextBox x:Name="TxtBestSelector" Text="body > div"
                                                     Background="Transparent" BorderThickness="0"
                                                     Foreground="{StaticResource ExTextPrimary}" FontFamily="Consolas" FontSize="11"
                                                     IsReadOnly="True" TextWrapping="Wrap"/>
                                        </Border>

                                        <TextBlock x:Name="LblXPath" Text="مسار XPath:" FontSize="11" Foreground="{StaticResource ExTextSecondary}"/>
                                        <Border Background="{StaticResource ExCanvasBg}" CornerRadius="4" Padding="10,8" Margin="0,4,0,0"
                                                BorderBrush="{StaticResource ExBorderSubtle}" BorderThickness="1">
                                            <TextBox x:Name="TxtXPath" Text="//div"
                                                     Background="Transparent" BorderThickness="0"
                                                     Foreground="{StaticResource ExTextPrimary}" FontFamily="Consolas" FontSize="11"
                                                     IsReadOnly="True" TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- Field Mappings -->
                            <TabItem x:Name="TabMappings" Header="مطابقة الحقول" FontSize="11.5">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="LblFieldSchema" Text="مخطط الحقول المستخرجة:" FontSize="11" Foreground="{StaticResource ExTextSecondary}" Margin="0,0,0,8"/>
                                        <StackPanel x:Name="PanelFieldMappings"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
