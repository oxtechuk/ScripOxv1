# ScripOx Extractor — Environment Configuration
# Copy this to .env and fill in your values

HOST=127.0.0.1
PORT=8765
DEBUG=false

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=scripox_user
DB_PASSWORD=CHANGE_ME
DB_NAME=scripox_db

# JWT
SECRET_KEY=CHANGE_ME_TO_32_CHAR_RANDOM_STRING

# Geocoding (nominatim = free, google = paid)
GEOCODING_PROVIDER=nominatim
GOOGLE_MAPS_API_KEY=

# Nominatim User Agent (use your app name)
NOMINATIM_USER_AGENT=scripox_oxtech
